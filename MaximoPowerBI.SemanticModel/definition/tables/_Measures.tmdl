			"<g transform='translate(11,130)' fill='none' stroke='#8B8B93' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4'/></g></g>" &
			"<text x='40' y='144' font-family='Segoe UI' font-size='15' fill='#B4B4BC'>Planning</text>" &
			"<g transform='translate(11,170)' fill='none' stroke='#8B8B93' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><circle cx='12' cy='12' r='9'/><path d='M12 11v6M12 7.5v.5'/></g></g>" &
			"<text x='40' y='184' font-family='Segoe UI' font-size='15' fill='#B4B4BC'>Information</text>" &
			"</svg>"
		displayFolder: Report Cards\0 Chrome
		lineageTag: d3bab2f4-f9e6-583e-af36-f0a7d95091c9

	/// Page title and the one-sentence headline under it.
	/// Expected: "Maintenance portfolio 3 sites · Jul 2023 – Jul 2026" / "We spend $3.1M a year
	/// more than our own benchmark — 70% of it at Houston. Aurora shows it can be won back."
	measure 'HTML OV Title' =
			VAR _AsOf = MIN ( [Data As Of Date], MAX ( DimDate[Date] ) )
			VAR _From = MAX ( CALCULATE ( MIN ( FactWorkOrder[ReportDate] ), REMOVEFILTERS ( DimDate ) ), MIN ( DimDate[Date] ) )
			VAR _N = COUNTROWS ( VALUES ( DimSite[SITEID] ) )
			VAR _Sites =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@gap", [Spend Above Benchmark],
			        "@yoy", [Reactive YoY %],
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Gap = SUMX ( _Sites, [@gap] )
			VAR _Top = TOPN ( 1, _Sites, [@gap], DESC )
			VAR _Best = TOPN ( 1, FILTER ( _Sites, [@gap] > 0 && [@yoy] < -0.10 ), [@yoy], ASC )
			VAR _Bold =
			    IF (
			        _Gap > 0,
			        "We spend $" & FORMAT ( _Gap / 1e6, "0.0", "en-US" ) & "M a year more than our own benchmark" &
			            IF ( _N > 1, " &#8212; " & FORMAT ( DIVIDE ( MAXX ( _Top, [@gap] ), _Gap ), "0%", "en-US" ) & " of it at " & MAXX ( _Top, [@n] ) ) & ".",
			        "Spend is at or under our own benchmark."
			    )
			VAR _Rest = IF ( NOT ISEMPTY ( _Best ), " " & MAXX ( _Best, [@n] ) & " shows it can be won back." )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1590 88' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='8' y='42' font-family='Segoe UI' font-size='40' font-weight='300' letter-spacing='-0.5' fill='#EDEDEF'>Maintenance portfolio" &
			"<tspan fill='#6E6E78'> " & _N & IF ( _N = 1, " site", " sites" ) & " &#183; " & FORMAT ( _From, "mmm yyyy", "en-US" ) & " &#8211; " & FORMAT ( _AsOf, "mmm yyyy", "en-US" ) & "</tspan></text>" &
			"<text x='8' y='73' font-family='Segoe UI' font-size='17' fill='#A1A1AA'><tspan font-weight='600' fill='#EDEDEF'>" & _Bold & "</tspan>" & _Rest & "</text></svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: 7677e505-5abc-5408-a8c6-6aa105662c8f

	/// KPI 1 (hero): spend above benchmark, split by site.
	/// Expected: "$3.1M/yr", bar Houston 70% / Aurora 30%, "Houston $2.2M · Aurora $0.9M · Bedford is the benchmark"
	measure 'HTML OV KPI Benchmark' =
			VAR _BarW = 422.6
			VAR _Sites =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@gap", [Spend Above Benchmark],
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Gap = SUMX ( _Sites, [@gap] )
			VAR _Pos = FILTER ( _Sites, [@gap] > 0 )
			VAR _Segs =
			    ADDCOLUMNS (
			        _Pos,
			        "@x", VAR _g = [@gap] RETURN 20 + DIVIDE ( SUMX ( FILTER ( _Pos, [@gap] > _g ), [@gap] ), _Gap ) * _BarW,
			        "@w", DIVIDE ( [@gap], _Gap ) * _BarW,
			        "@first", VAR _g = [@gap] RETURN COUNTROWS ( FILTER ( _Pos, [@gap] > _g ) ) = 0
			    )
			VAR _Bars =
			    CONCATENATEX (
			        _Segs,
			        IF ( [@first],
			            "<rect x='" & FORMAT ( [@x] - 6, "0.0", "en-US" ) & "' y='123' width='" & FORMAT ( [@w] + 12, "0.0", "en-US" ) & "' height='22' rx='10' fill='" & [@c] & "' fill-opacity='0.07'/>" &
			            "<rect x='" & FORMAT ( [@x] - 3, "0.0", "en-US" ) & "' y='126' width='" & FORMAT ( [@w] + 6, "0.0", "en-US" ) & "' height='16' rx='7' fill='" & [@c] & "' fill-opacity='0.16'/>" ) &
			        "<rect x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='129' width='" & FORMAT ( MAX ( [@w] - 2, 1 ), "0.0", "en-US" ) & "' height='10' rx='3' fill='" & [@c] & "'/>",
			        "", [@gap], DESC
			    )
			VAR _Named =
			    CONCATENATEX (
			        _Pos,
			        "<tspan fill='" & [@c] & "'>" & [@n] & " $" & FORMAT ( [@gap] / 1e6, "0.0", "en-US" ) & "M</tspan>",
			        " &#183; ", [@gap], DESC
			    )
			VAR _Bench = CONCATENATEX ( FILTER ( _Sites, [@gap] <= 0 ), [@n], " and " )
			VAR _Legend =
			    _Named & IF ( _Bench <> "", IF ( _Named <> "", " &#183; " ) & _Bench & IF ( COUNTROWS ( FILTER ( _Sites, [@gap] <= 0 ) ) = 1, " is", " are" ) & " the benchmark" )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 462.6 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Spend above our own benchmark</text>" &
			"<text x='20' y='100' font-family='Segoe UI' font-size='64' font-weight='500' letter-spacing='-1.5' fill='#EDEDEF'>$" & FORMAT ( _Gap / 1e6, "0.0", "en-US" ) & "M<tspan dx='3' font-size='20' letter-spacing='0' fill='#8B8B93'>/yr</tspan></text>" &
			"<rect x='20' y='129' width='422.6' height='10' rx='3' fill='#222227'/>" & _Bars &
			"<text x='20' y='157' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & _Legend & "</text></svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: af8d25c9-cc3d-53d8-abf8-ed649e45b67e

	/// KPI 2: annual maintenance spend, with cost as % of asset value on a 0-10% scale.
	/// Band = best practice 2-3%, tick = 3%. Expected: "$9.3M", "▲ 6.0% of asset value", red.
	measure 'HTML OV KPI Spend' =
			VAR _PW = 224.4
			VAR _V = [Maintenance Cost % of RAV]
			VAR _C = IF ( _V <= 0.03, "#4ADE80", IF ( _V <= 0.04, "#FBBF24", "#F87171" ) )
			VAR _G = IF ( _V <= 0.03, "&#10003;", IF ( _V <= 0.04, "&#9679;", "&#9650;" ) )
			VAR _FillW = MIN ( 1, MAX ( 0, _V / 0.10 ) ) * _PW
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.4 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Annual maintenance spend</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>$" & FORMAT ( [Annual Maintenance Spend] / 1e6, "0.0", "en-US" ) & "M</text>" &
			"<rect x='20' y='102' width='224.4' height='4' rx='2' fill='#222227'/>" &
			"<rect x='" & FORMAT ( 20 + 0.2 * _PW, "0.0", "en-US" ) & "' y='102' width='" & FORMAT ( 0.1 * _PW, "0.0", "en-US" ) & "' height='4' fill='#4ADE80' fill-opacity='0.25'/>" &
			"<rect x='17' y='99' width='" & FORMAT ( _FillW + 6, "0.0", "en-US" ) & "' height='10' rx='5' fill='" & _C & "' fill-opacity='0.12'/>" &
			"<rect x='20' y='102' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='4' rx='2' fill='" & _C & "'/>" &
			"<rect x='" & FORMAT ( 19 + 0.3 * _PW, "0.0", "en-US" ) & "' y='97' width='2' height='14' fill='#E4E4E7'/>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='" & _C & "'>" & _G & " " & FORMAT ( _V * 100, "0.0", "en-US" ) & "% of asset value</text>" &
			"<text x='244.4' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>best 2&#8211;3%</text></svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: c6ac4026-c4e8-5b07-a063-c1bd347913e4

	/// KPI 3: share of spend on reactive work, and what a reactive job costs against a PM.
	/// Expected: "62%", "$1,288 per reactive job", "$234 per PM", "5.5× the cost of a PM", "of $9.3M"
	measure 'HTML OV KPI Unplanned' =
			VAR _R = [Cost per Reactive Job]
			VAR _P = [Cost per PM]
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.3 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Spent on unplanned work</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( [Reactive Cost Share], "0%", "en-US" ) & "</text>" &
			"<text x='20' y='111' font-family='Consolas' font-size='12' fill='#A1A1AA'>$" & FORMAT ( _R, "#,0", "en-US" ) & " per reactive job</text>" &
			"<text x='20' y='126' font-family='Consolas' font-size='12' fill='#A1A1AA'>$" & FORMAT ( _P, "#,0", "en-US" ) & " per PM</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#FBBF24'>" & FORMAT ( DIVIDE ( _R, _P ), "0.0", "en-US" ) & "&#215; the cost of a PM</text>" &
			"<text x='244.3' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>of $" & FORMAT ( [Annual Maintenance Spend] / 1e6, "0.0", "en-US" ) & "M</text></svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: 4a22674e-e2e5-521b-9662-4101f2846f4a

	/// KPI 4: statutory inspection + safety jobs finished late. Target 0.
	/// Expected: "480", "▲ 0 of 3 sites at 100%"
	measure 'HTML OV KPI Statutory' =
			VAR _Sites = VALUES ( DimSite[SITEID] )
			VAR _N = COUNTROWS ( _Sites )
			VAR _Ok = COUNTROWS ( FILTER ( _Sites, [Statutory Finished Late] = 0 ) ) + 0
			VAR _C = IF ( _Ok = _N, "#4ADE80", "#F87171" )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.3 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Statutory inspections late</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( [Statutory Finished Late], "#,0", "en-US" ) & "</text>" &
			"<text x='20' y='111' font-family='Consolas' font-size='12' fill='#A1A1AA'>regulatory &amp; safety exposure</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='" & _C & "'>" & IF ( _Ok = _N, "&#10003;", "&#9650;" ) & " " & _Ok & " of " & _N & IF ( _N = 1, " site", " sites" ) & " at 100%</text>" &
			"<text x='244.3' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>target 0</text></svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: 93c3596c-9433-54c5-8b0e-5f467a15b191

	/// KPI 5: reactive work orders, last 12 complete months against the 12 before, per site.
	/// Green when down more than 5%, red when up, grey in between. Expected: Houston +5%, Aurora -21%, Bedford -2%
	measure 'HTML OV KPI YoY' =
			VAR _Sites =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@yoy", [Reactive YoY %],
			        "@o", SWITCH ( DimSite[SITEID], "HOUSTON", 1, "AURORA", 2, "BEDFORD", 3, 9 ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Rows =
			    ADDCOLUMNS ( _Sites, "@y", VAR _o = [@o] RETURN 70 + 24 * COUNTROWS ( FILTER ( _Sites, [@o] < _o ) ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.4 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Reactive work, year on year</text>" &
			CONCATENATEX (
			    _Rows,
			    VAR _v = [@yoy]
			    VAR _col = IF ( _v < -0.05, "#4ADE80", IF ( _v > 0, "#F87171", "#A1A1AA" ) )
			    RETURN
			    "<circle cx='24' cy='" & ( [@y] - 5 ) & "' r='4' fill='" & [@c] & "'/>" &
			    "<text x='35' y='" & [@y] & "' font-family='Segoe UI' font-size='14' fill='#EDEDEF'>" & [@n] & "</text>" &
			    "<text x='244.4' y='" & [@y] & "' text-anchor='end' font-family='Consolas' font-size='14' font-weight='600' fill='" & _col & "'>" &
			        IF ( _v < 0, "&#9660;", "&#9650;" ) & " " & FORMAT ( _v * 100, "+0;-0;0", "en-US" ) & "%</text>",
			    "", [@o], ASC
			) &
			"<text x='244.4' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>last 12 vs prior 12 mo</text></svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: f5c9d010-faa4-506b-a929-57dada759e2b

	/// Card: where is the money going. One bar per site: planned (grey) + reactive (red, glowing),
	/// white tick = what the site would spend at Bedford's cost rate.
	/// Expected: Houston $5.0M (+$2.2M over), Aurora $2.4M (+$0.9M over), Bedford $2.0M (the benchmark)
	measure 'HTML OV Money' =
			VAR _T =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@tot", [Annual Maintenance Spend],
			        "@plan", [Annual Planned Spend],
			        "@bench", [Spend at Benchmark Rate],
			        "@gap", [Spend Above Benchmark],
			        "@rav", [Maintenance Cost % of RAV],
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Max = MAXX ( _T, [@tot] )
			VAR _Mx = _Max * 1.12
			VAR _Step = IF ( _Max > 8e6, 2e6, 1e6 )
			VAR _Rows = ADDCOLUMNS ( _T, "@y", VAR _tv = [@tot] RETURN 84 + 68 * COUNTROWS ( FILTER ( _T, [@tot] > _tv ) ) )
			VAR _Grid =
			    CONCATENATEX (
			        GENERATESERIES ( 0, _Max, _Step ),
			        VAR _x = FORMAT ( 132 + [Value] / _Mx * 460, "0.0", "en-US" )
			        RETURN
			        "<line x1='" & _x & "' x2='" & _x & "' y1='76' y2='284' stroke='#1D1D21'/>" &
			        "<text x='" & _x & "' y='300' text-anchor='middle' font-family='Consolas' font-size='11' fill='#5C5C66'>$" & FORMAT ( [Value] / 1e6, "0", "en-US" ) & "M</text>",
			        ""
			    )
			VAR _Bars =
			    CONCATENATEX (
			        _Rows,
			        VAR _y = [@y]
			        VAR _x0 = 132
			        VAR _xp = 132 + [@plan] / _Mx * 460
			        VAR _xt = 132 + [@tot] / _Mx * 460
			        VAR _xb = FORMAT ( 132 + [@bench] / _Mx * 460, "0.0", "en-US" )
			        RETURN
			        "<text x='22' y='" & ( _y + 22 ) & "' font-family='Segoe UI' font-size='16' font-weight='600' fill='" & [@c] & "'>" & [@n] & "</text>" &
			        "<text x='22' y='" & ( _y + 40 ) & "' font-family='Consolas' font-size='11.5' fill='#A1A1AA'>" & FORMAT ( [@rav] * 100, "0.0", "en-US" ) & "% of RAV</text>" &
			        "<rect x='" & FORMAT ( _xp - 8, "0.0", "en-US" ) & "' y='" & ( _y - 8 ) & "' width='" & FORMAT ( _xt - _xp + 16, "0.0", "en-US" ) & "' height='56' rx='14' fill='#F87171' fill-opacity='0.06'/>" &
			        "<rect x='" & FORMAT ( _xp - 4, "0.0", "en-US" ) & "' y='" & ( _y - 4 ) & "' width='" & FORMAT ( _xt - _xp + 8, "0.0", "en-US" ) & "' height='48' rx='10' fill='#F87171' fill-opacity='0.12'/>" &
			        "<rect x='132' y='" & _y & "' width='" & FORMAT ( _xp - _x0, "0.0", "en-US" ) & "' height='40' rx='6' fill='#A1A1AA' fill-opacity='0.55'/>" &
			        "<rect x='" & FORMAT ( _xp, "0.0", "en-US" ) & "' y='" & _y & "' width='" & FORMAT ( _xt - _xp, "0.0", "en-US" ) & "' height='40' rx='6' fill='#F87171' fill-opacity='0.9'/>" &
			        "<line x1='" & _xb & "' x2='" & _xb & "' y1='" & ( _y - 6 ) & "' y2='" & ( _y + 46 ) & "' stroke='#F4F4F5' stroke-width='2.5'/>" &
			        "<text x='" & FORMAT ( _xt + 12, "0.0", "en-US" ) & "' y='" & ( _y + 18 ) & "' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>$" & FORMAT ( [@tot] / 1e6, "0.0", "en-US" ) & "M</text>" &
			        IF ( [@gap] > 1,
			            "<text x='" & FORMAT ( _xt + 12, "0.0", "en-US" ) & "' y='" & ( _y + 36 ) & "' font-family='Consolas' font-size='12.5' font-weight='600' fill='#F87171'>+$" & FORMAT ( [@gap] / 1e6, "0.0", "en-US" ) & "M over</text>",
			            "<text x='" & FORMAT ( _xt + 12, "0.0", "en-US" ) & "' y='" & ( _y + 36 ) & "' font-family='Consolas' font-size='12.5' font-weight='600' fill='#4ADE80'>the benchmark</text>" ),
			        "", [@tot], DESC
			    )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 781 330' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Where is the money going?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>annual maintenance spend by site &#183; white tick = spend at Bedford&#8217;s cost rate</text>" &
			_Grid & _Bars &
			"<g font-family='Consolas' font-size='12' fill='#A1A1AA'>" &
			"<rect x='22' y='313' width='10' height='10' rx='3' fill='#A1A1AA' fill-opacity='0.6'/><text x='38' y='322'>planned work</text>" &
			"<rect x='135' y='313' width='10' height='10' rx='3' fill='#F87171'/><text x='151' y='322'>reactive work</text>" &
			"<rect x='256' y='313' width='3' height='10' rx='1' fill='#F4F4F5'/><text x='265' y='322'>spend at Bedford&#8217;s rate</text></g></svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: 3f77da19-37e6-58a5-b448-e0f3ae56be4d

	/// Card: which sites need intervention. Reactive share of work orders (x) against cost as %
	/// of asset value (y), bubble = annual spend. Green zone = < 20% reactive and <= 3% of asset value.
	measure 'HTML OV Quad' =
			VAR _T =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@rx", MIN ( 50, MAX ( 0, [Reactive Maintenance %] * 100 ) ),
			        "@cy", MIN ( 9, MAX ( 0, [Maintenance Cost % of RAV] * 100 ) ),
			        "@tot", [Annual Maintenance Spend],
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _MaxT = MAXX ( _T, [@tot] )
			VAR _Grid =
			    CONCATENATEX (
			        { 0, 3, 6, 9 },
			        VAR _y = FORMAT ( 78 + ( 9 - [Value] ) / 9 * 218, "0.0", "en-US" )
			        RETURN
			        "<line x1='68' x2='746' y1='" & _y & "' y2='" & _y & "' stroke='#1D1D21'/>" &
			        "<text x='60' y='" & FORMAT ( 82 + ( 9 - [Value] ) / 9 * 218, "0.0", "en-US" ) & "' text-anchor='end' font-family='Consolas' font-size='11' fill='#5C5C66'>" & [Value] & "%</text>",
			        ""
			    ) &
			    CONCATENATEX (
			        { 0, 10, 20, 30, 40, 50 },
			        "<text x='" & FORMAT ( 68 + [Value] / 50 * 678, "0.0", "en-US" ) & "' y='314' text-anchor='middle' font-family='Consolas' font-size='11' fill='#5C5C66'>" & [Value] & "%</text>",
			        ""
			    )
			VAR _Dots =
			    CONCATENATEX (
			        _T,
			        VAR _x = 68 + [@rx] / 50 * 678
			        VAR _y = 78 + ( 9 - [@cy] ) / 9 * 218
			        VAR _r = 9 + DIVIDE ( [@tot], _MaxT ) * 16
			        VAR _lx = SWITCH ( DimSite[SITEID], "HOUSTON", _x, "AURORA", _x - _r - 12, _x + _r + 12 )
			        VAR _ly = SWITCH ( DimSite[SITEID], "HOUSTON", _y + _r + 20, _y + 2 )
			        VAR _a = SWITCH ( DimSite[SITEID], "HOUSTON", "middle", "AURORA", "end", "start" )
			        VAR _cx = FORMAT ( _x, "0.0", "en-US" )
			        VAR _cy = FORMAT ( _y, "0.0", "en-US" )
			        RETURN
			        "<circle cx='" & _cx & "' cy='" & _cy & "' r='" & FORMAT ( _r + 10, "0.0", "en-US" ) & "' fill='" & [@c] & "' fill-opacity='0.10'/>" &
			        "<circle cx='" & _cx & "' cy='" & _cy & "' r='" & FORMAT ( _r + 5, "0.0", "en-US" ) & "' fill='" & [@c] & "' fill-opacity='0.16'/>" &
			        "<circle cx='" & _cx & "' cy='" & _cy & "' r='" & FORMAT ( _r, "0.0", "en-US" ) & "' fill='" & [@c] & "' fill-opacity='0.85'/>" &
			        "<text x='" & FORMAT ( _lx, "0.0", "en-US" ) & "' y='" & FORMAT ( _ly, "0.0", "en-US" ) & "' text-anchor='" & _a & "' font-family='Segoe UI' font-size='15' font-weight='600' fill='" & [@c] & "'>" & [@n] & "</text>" &
			        "<text x='" & FORMAT ( _lx, "0.0", "en-US" ) & "' y='" & FORMAT ( _ly + 16, "0.0", "en-US" ) & "' text-anchor='" & _a & "' font-family='Consolas' font-size='11.5' fill='#A1A1AA'>$" & FORMAT ( [@tot] / 1e6, "0.0", "en-US" ) & "M/yr</text>",
			        "", [@tot], ASC
			    )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 781 330' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Which sites need intervention?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>bubble size = annual spend &#183; green zone = &lt; 20% reactive and &#8804; 3% of asset value</text>" &
			"<rect x='68' y='223.3' width='271.2' height='72.7' fill='#4ADE80' fill-opacity='0.10'/>" &
			"<rect x='474.8' y='78' width='271.2' height='96.9' fill='#F87171' fill-opacity='0.08'/>" &
			_Grid &
			"<text x='81.6' y='286.3' font-family='Consolas' font-size='11' font-weight='600' fill='#4ADE80'>WORLD-CLASS</text>" &
			"<text x='485.6' y='90.1' font-family='Consolas' font-size='11' font-weight='600' fill='#F87171'>INTERVENE</text>" &
			"<text x='407' y='329' text-anchor='middle' font-family='Consolas' font-size='11' fill='#A1A1AA'>reactive share of work orders &#8594;</text>" &
			"<text x='34' y='187' transform='rotate(-90 34 187)' text-anchor='middle' font-family='Consolas' font-size='11' fill='#A1A1AA'>cost % of asset value &#8594;</text>" &
			_Dots & "</svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: 57760bff-c3c9-5e09-bf4e-b99bee331353

	/// Card: is it getting better. Reactive work orders by month for each site: solid = the last 12
	/// complete months (shaded, glowing), dashed = the same month a year earlier. Each panel has its own scale.
	measure 'HTML OV Trend' =
			VAR _End = EOMONTH ( [Data As Of Date], -1 )
			VAR _Start = EOMONTH ( [Data As Of Date], -13 ) + 1
			VAR _Sites =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@yoy", [Reactive YoY %],
			        "@o", SWITCH ( DimSite[SITEID], "HOUSTON", 1, "AURORA", 2, "BEDFORD", 3, 9 ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Panels =
			    ADDCOLUMNS ( _Sites, "@k", VAR _o = [@o] RETURN COUNTROWS ( FILTER ( _Sites, [@o] < _o ) ) )
			VAR _Body =
			    CONCATENATEX (
			        _Panels,
			        VAR _px = 22 + [@k] * 356.67
			        VAR _c = [@c]
			        VAR _v = [@yoy]
			        VAR _vc = IF ( _v < -0.05, "#4ADE80", IF ( _v > 0, "#F87171", "#A1A1AA" ) )
			        VAR _M =
			            ADDCOLUMNS (
			                GENERATESERIES ( 0, 11, 1 ),
			                "@m", EDATE ( _Start, [Value] ),
			                "@ty", CALCULATE ( [Reactive Work Orders], REMOVEFILTERS ( DimDate ),
			                        DATESBETWEEN ( DimDate[Date], EDATE ( _Start, [Value] ), EOMONTH ( _Start, [Value] ) ) ) + 0,
			                "@ly", CALCULATE ( [Reactive Work Orders], REMOVEFILTERS ( DimDate ),
			                        DATESBETWEEN ( DimDate[Date], EDATE ( _Start, [Value] - 12 ), EOMONTH ( _Start, [Value] - 12 ) ) ) + 0
			            )
			        VAR _Hi = MAX ( MAXX ( _M, [@ty] ), MAXX ( _M, [@ly] ) )
			        VAR _StepY = IF ( _Hi > 100, 100, 50 )
			        VAR _Top = ( INT ( _Hi / _StepY ) + 1 ) * _StepY
			        VAR _H = 272 / 11
			        VAR _P =
			            ADDCOLUMNS ( _M, "@x", _px + 30 + [Value] * _H, "@yt", 101 + ( _Top - [@ty] ) / _Top * 200, "@yl", 101 + ( _Top - [@ly] ) / _Top * 200 )
			        // slopes per segment, then monotone tangents per point (Fritsch-Butland)
			        VAR _D =
			            ADDCOLUMNS (
			                _P,
			                "@dt", VAR _i = [Value] RETURN DIVIDE ( MAXX ( FILTER ( _P, [Value] = _i + 1 ), [@yt] ) - [@yt], _H ),
			                "@dl", VAR _i = [Value] RETURN DIVIDE ( MAXX ( FILTER ( _P, [Value] = _i + 1 ), [@yl] ) - [@yl], _H )
			            )
			        VAR _T =
			            ADDCOLUMNS (
			                _D,
			                "@mt",
			                    VAR _i = [Value]
			                    VAR _a = MAXX ( FILTER ( _D, [Value] = _i - 1 ), [@dt] )
			                    VAR _b = [@dt]
			                    RETURN IF ( _i = 0, _b, IF ( _i = 11, _a, IF ( _a * _b <= 0, 0, ( _a + _b ) / 2 * MIN ( 1, 3 * MIN ( ABS ( _a ), ABS ( _b ) ) / MAX ( ABS ( ( _a + _b ) / 2 ), 1e-9 ) ) ) ) ),
			                "@ml",
			                    VAR _i = [Value]
			                    VAR _a = MAXX ( FILTER ( _D, [Value] = _i - 1 ), [@dl] )
			                    VAR _b = [@dl]
			                    RETURN IF ( _i = 0, _b, IF ( _i = 11, _a, IF ( _a * _b <= 0, 0, ( _a + _b ) / 2 * MIN ( 1, 3 * MIN ( ABS ( _a ), ABS ( _b ) ) / MAX ( ABS ( ( _a + _b ) / 2 ), 1e-9 ) ) ) ) )
			            )
			        VAR _x0 = FORMAT ( _px + 30, "0.0", "en-US" )
			        VAR _y00 = MAXX ( FILTER ( _T, [Value] = 0 ), [@yt] )
			        VAR _l00 = MAXX ( FILTER ( _T, [Value] = 0 ), [@yl] )
			        VAR _CurveT =
			            CONCATENATEX (
			                FILTER ( _T, [Value] < 11 ),
			                VAR _i = [Value]
			                VAR _x1 = [@x]
			                VAR _y1 = [@yt]
			                VAR _m1 = [@mt]
			                VAR _x2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@x] )
			                VAR _y2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@yt] )
			                VAR _m2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@mt] )
			                VAR _h3 = _H / 3
			                RETURN
			                " C" & FORMAT ( _x1 + _h3, "0.0", "en-US" ) & "," & FORMAT ( _y1 + _m1 * _h3, "0.0", "en-US" ) & " " &
			                FORMAT ( _x2 - _h3, "0.0", "en-US" ) & "," & FORMAT ( _y2 - _m2 * _h3, "0.0", "en-US" ) & " " &
			                FORMAT ( _x2, "0.0", "en-US" ) & "," & FORMAT ( _y2, "0.0", "en-US" ),
			                "", [Value], ASC
			            )
			        VAR _CurveL =
			            CONCATENATEX (
			                FILTER ( _T, [Value] < 11 ),
			                VAR _i = [Value]
			                VAR _x1 = [@x]
			                VAR _y1 = [@yl]
			                VAR _m1 = [@ml]
			                VAR _x2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@x] )
			                VAR _y2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@yl] )
			                VAR _m2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@ml] )
			                VAR _h3 = _H / 3
			                RETURN
			                " C" & FORMAT ( _x1 + _h3, "0.0", "en-US" ) & "," & FORMAT ( _y1 + _m1 * _h3, "0.0", "en-US" ) & " " &
			                FORMAT ( _x2 - _h3, "0.0", "en-US" ) & "," & FORMAT ( _y2 - _m2 * _h3, "0.0", "en-US" ) & " " &
			                FORMAT ( _x2, "0.0", "en-US" ) & "," & FORMAT ( _y2, "0.0", "en-US" ),
			                "", [Value], ASC
			            )
			        VAR _PathT = "M" & _x0 & "," & FORMAT ( _y00, "0.0", "en-US" ) & _CurveT
			        VAR _PathL = "M" & _x0 & "," & FORMAT ( _l00, "0.0", "en-US" ) & _CurveL
			        VAR _xe = FORMAT ( _px + 302, "0.0", "en-US" )
			        VAR _ye = FORMAT ( MAXX ( FILTER ( _T, [Value] = 11 ), [@yt] ), "0.0", "en-US" )
			        RETURN
			        "<circle cx='" & FORMAT ( _px + 4, "0.0", "en-US" ) & "' cy='79' r='7' fill='" & _c & "' fill-opacity='0.25'/>" &
			        "<circle cx='" & FORMAT ( _px + 4, "0.0", "en-US" ) & "' cy='79' r='4' fill='" & _c & "'/>" &
			        "<text x='" & FORMAT ( _px + 15, "0.0", "en-US" ) & "' y='84' font-family='Segoe UI' font-size='14' font-weight='600' fill='#EDEDEF'>" & [@n] & "</text>" &
			        "<text x='" & FORMAT ( _px + 334.67, "0.0", "en-US" ) & "' y='84' text-anchor='end' font-family='Consolas' font-size='14' font-weight='600' fill='" & _vc & "'>" & FORMAT ( _v * 100, "+0;-0;0", "en-US" ) & "%</text>" &
			        CONCATENATEX (
			            { 0, 0.5, 1 },
			            VAR _gy = FORMAT ( 101 + ( 1 - [Value] ) * 200, "0.0", "en-US" )
			            RETURN
			            "<line x1='" & _x0 & "' x2='" & _xe & "' y1='" & _gy & "' y2='" & _gy & "' stroke='#1D1D21'/>" &
			            "<text x='" & FORMAT ( _px + 24, "0.0", "en-US" ) & "' y='" & FORMAT ( 105 + ( 1 - [Value] ) * 200, "0.0", "en-US" ) & "' text-anchor='end' font-family='Consolas' font-size='12' fill='#5C5C66'>" & ( _Top * [Value] ) & "</text>",
			            ""
			        ) &
			        "<path d='" & _PathL & "' fill='none' stroke='#71717A' stroke-width='1.6' stroke-dasharray='4 4'/>" &
			        "<path d='" & _PathT & " L" & _xe & ",301 L" & _x0 & ",301 Z' fill='" & _c & "' fill-opacity='0.09'/>" &
			        "<path d='" & _PathT & "' fill='none' stroke='" & _c & "' stroke-width='14.4' stroke-opacity='0.06' stroke-linecap='round'/>" &
			        "<path d='" & _PathT & "' fill='none' stroke='" & _c & "' stroke-width='7.2' stroke-opacity='0.16' stroke-linecap='round'/>" &
			        "<path d='" & _PathT & "' fill='none' stroke='" & _c & "' stroke-width='2.4' stroke-linecap='round'/>" &
			        "<circle cx='" & _xe & "' cy='" & _ye & "' r='4' fill='" & _c & "'/>" &
			        CONCATENATEX (
			            FILTER ( _T, [Value] IN { 0, 3, 6, 9, 11 } ),
			            "<text x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='319' text-anchor='middle' font-family='Consolas' font-size='12' fill='#5C5C66'>" & FORMAT ( [@m], "mmm", "en-US" ) & "</text>",
			            ""
			        ),
			        "", [@o], ASC
			    )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1092 322' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Is it getting better?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>reactive work orders by month &#183; solid = last 12 complete months &#183; dashed = same month a year earlier</text>" &
			_Body & "</svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: bb6d6875-1666-5ff6-894f-51f0ef3f0b6e

	/// Card: where is our compliance risk. Statutory jobs finished late per site, worst first.
	/// Expected: Houston 321 (70.8% on time), Aurora 103 (83.7%), Bedford 56 (90.7%)
	measure 'HTML OV Risk' =
			VAR _T =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@late", [Statutory Finished Late] + 0,
			        "@ot", [Statutory On-Time %],
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Max = MAX ( MAXX ( _T, [@late] ), 1 )
			VAR _Rows = ADDCOLUMNS ( _T, "@k", VAR _l = [@late] VAR _n = [@n] RETURN COUNTROWS ( FILTER ( _T, [@late] > _l || ( [@late] = _l && [@n] < _n ) ) ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 470 322' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Where is our compliance risk?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>statutory inspections finished late &#183; target 0</text>" &
			CONCATENATEX (
			    _Rows,
			    VAR _y = 89 + 69 * [@k]
			    VAR _w = [@late] / _Max * 332.3
			    RETURN
			    "<circle cx='26' cy='" & ( _y - 5 ) & "' r='4' fill='" & [@c] & "'/>" &
			    "<text x='38' y='" & _y & "' font-family='Segoe UI' font-size='14' fill='#EDEDEF'>" & [@n] & "</text>" &
			    "<text x='448' y='" & _y & "' text-anchor='end' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & FORMAT ( [@ot] * 100, "0.0", "en-US" ) & "% on time</text>" &
			    IF ( _w > 0,
			        "<rect x='16' y='" & ( _y + 12 ) & "' width='" & FORMAT ( _w + 12, "0.0", "en-US" ) & "' height='28' rx='10' fill='#F87171' fill-opacity='0.07'/>" &
			        "<rect x='19' y='" & ( _y + 15 ) & "' width='" & FORMAT ( _w + 6, "0.0", "en-US" ) & "' height='22' rx='7' fill='#F87171' fill-opacity='0.12'/>" &
			        "<rect x='22' y='" & ( _y + 18 ) & "' width='" & FORMAT ( _w, "0.0", "en-US" ) & "' height='16' rx='4' fill='#F87171'/>" ) &
			    "<text x='" & FORMAT ( 22 + _w + 12, "0.0", "en-US" ) & "' y='" & ( _y + 33 ) & "' font-family='Segoe UI' font-size='20' font-weight='600' fill='" & IF ( [@late] = 0, "#4ADE80", "#F87171" ) & "'>" & FORMAT ( [@late], "#,0", "en-US" ) & "</text>",
			    "", [@k], ASC
			) & "</svg>"
		displayFolder: Report Cards\1 Overview
		lineageTag: cbcac7fe-3580-53b1-9ff0-6179720bcf02

	/// Page title and headline.
	/// Expected: "40 statutory jobs are overdue today — 23 at Houston. The oldest (Replace faulty
	/// emergency stop) is 81 days late and still waiting for approval."
	measure 'HTML PM Title' =
			VAR _AsOf = [Data As Of Date]
			VAR _N = [Statutory Overdue Today]
			VAR _Top = TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@n", [Statutory Overdue Today] ), [@n], DESC )
			VAR _TopName = UPPER ( LEFT ( MAXX ( _Top, DimSite[SITEID] ), 1 ) ) & LOWER ( MID ( MAXX ( _Top, DimSite[SITEID] ), 2, 50 ) )
			VAR _Old =
			    TOPN (
			        1,
			        CALCULATETABLE (
			            SELECTCOLUMNS ( FactWorkOrder, "@d", FactWorkOrder[DaysOverdue], "@w", FactWorkOrder[WONUM], "@t", FactWorkOrder[DESCRIPTION], "@s", FactWorkOrder[STATUS] ),
			            FactWorkOrder[IsOpen] = 1, FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" }, NOT ISBLANK ( FactWorkOrder[DaysOverdue] ), REMOVEFILTERS ( DimDate )
			        ),
			        [@d], DESC, [@w], ASC
			    )
			VAR _Status = SWITCH ( MAXX ( _Old, [@s] ), "WAPPR", "still waiting for approval", "APPR", "approved but not started", "INPRG", "in progress", "open" )
			VAR _Bold =
			    IF ( _N > 0,
			        _N & " statutory job" & IF ( _N = 1, " is", "s are" ) & " overdue today" & IF ( COUNTROWS ( VALUES ( DimSite[SITEID] ) ) > 1, " &#8212; " & MAXX ( _Top, [@n] ) & " at " & _TopName ) & ".",
			        "No statutory jobs are overdue today." )
			VAR _Rest = IF ( _N > 0, " The oldest (" & MAXX ( _Old, [@t] ) & ") is " & MAXX ( _Old, [@d] ) & " days late and " & _Status & "." )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1590 88' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='8' y='42' font-family='Segoe UI' font-size='40' font-weight='300' letter-spacing='-0.5' fill='#EDEDEF'>PM &amp; Compliance" &
			"<tspan fill='#6E6E78'> open work as of " & FORMAT ( _AsOf, "d mmm yyyy", "en-US" ) & "</tspan></text>" &
			"<text x='8' y='73' font-family='Segoe UI' font-size='17' fill='#A1A1AA'><tspan font-weight='600' fill='#EDEDEF'>" & _Bold & "</tspan>" & _Rest & "</text></svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: 40cd875c-c5b8-5e19-ac13-bbf9986a7dfd

	/// KPI 1 (hero): statutory jobs overdue today, split by site.
	/// Expected: "40", "Houston 23 · Aurora 10 · Bedford 7"
	measure 'HTML PM KPI Overdue' =
			VAR _BarW = 422.6
			VAR _Sites =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@v", [Statutory Overdue Today],
			        "@o", SWITCH ( DimSite[SITEID], "HOUSTON", 1, "AURORA", 2, "BEDFORD", 3, 9 ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Tot = SUMX ( _Sites, [@v] )
			VAR _Pos = FILTER ( _Sites, [@v] > 0 )
			VAR _Segs =
			    ADDCOLUMNS (
			        _Pos,
			        "@x", VAR _o = [@o] RETURN 20 + DIVIDE ( SUMX ( FILTER ( _Pos, [@o] < _o ), [@v] ), _Tot ) * _BarW,
			        "@w", DIVIDE ( [@v], _Tot ) * _BarW,
			        "@first", VAR _o = [@o] RETURN COUNTROWS ( FILTER ( _Pos, [@o] < _o ) ) = 0
			    )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 462.6 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Statutory jobs overdue today</text>" &
			"<text x='20' y='100' font-family='Segoe UI' font-size='64' font-weight='500' letter-spacing='-1.5' fill='#EDEDEF'>" & FORMAT ( _Tot, "#,0", "en-US" ) & "</text>" &
			"<rect x='20' y='129' width='422.6' height='10' rx='3' fill='#222227'/>" &
			CONCATENATEX (
			    _Segs,
			    IF ( [@first],
			        "<rect x='" & FORMAT ( [@x] - 6, "0.0", "en-US" ) & "' y='123' width='" & FORMAT ( [@w] + 12, "0.0", "en-US" ) & "' height='22' rx='10' fill='" & [@c] & "' fill-opacity='0.07'/>" &
			        "<rect x='" & FORMAT ( [@x] - 3, "0.0", "en-US" ) & "' y='126' width='" & FORMAT ( [@w] + 6, "0.0", "en-US" ) & "' height='16' rx='7' fill='" & [@c] & "' fill-opacity='0.16'/>" ) &
			    "<rect x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='129' width='" & FORMAT ( MAX ( [@w] - 2, 1 ), "0.0", "en-US" ) & "' height='10' rx='3' fill='" & [@c] & "'/>",
			    "", [@o], ASC
			) &
			"<text x='20' y='157' font-family='Consolas' font-size='12' fill='#A1A1AA'>" &
			CONCATENATEX ( _Sites, "<tspan fill='" & [@c] & "'>" & [@n] & " " & [@v] & "</tspan>", " &#183; ", [@o], ASC ) &
			"</text></svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: 13c4b1c9-1d19-5f01-a614-e32af8aa4e1d

	/// KPI 2: statutory jobs due in the next 30 days. Footer = the site with the most.
	/// Expected: "38", "● Houston 26"
	measure 'HTML PM KPI Due' =
			VAR _Top = TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@v", [Statutory Due Next 30 Days] ), [@v], DESC, DimSite[SITEID], ASC )
			VAR _Id = MAXX ( _Top, DimSite[SITEID] )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.4 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Statutory due in next 30 days</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( [Statutory Due Next 30 Days], "#,0", "en-US" ) & "</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#FBBF24'>&#9679; " & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & " " & MAXX ( _Top, [@v] ) & "</text></svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: c59ff3ef-e0eb-528b-b27c-7bf028fe5f8b

	/// KPI 3: PMs overdue today. Footer = the site with the most.
	/// Expected: "610", "Houston 352"
	measure 'HTML PM KPI PMs' =
			VAR _Top = TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@v", [PMs Overdue Today] ), [@v], DESC, DimSite[SITEID], ASC )
			VAR _Id = MAXX ( _Top, DimSite[SITEID] )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.3 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>PMs overdue today</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( [PMs Overdue Today], "#,0", "en-US" ) & "</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#A1A1AA'>" & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & " " & MAXX ( _Top, [@v] ) & "</text></svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: 658946dd-6c77-545c-aa35-4933f2c1f7ed

	/// KPI 4: statutory jobs finished on time, against a 100% target.
	/// Expected: "79.5%", red bar, "▲ 480 finished late", "target 100%"
	measure 'HTML PM KPI Statutory' =
			VAR _V = [Statutory On-Time %]
			VAR _C = IF ( _V >= 1, "#4ADE80", IF ( _V >= 0.95, "#FBBF24", "#F87171" ) )
			VAR _G = IF ( _V >= 1, "&#10003;", IF ( _V >= 0.95, "&#9679;", "&#9650;" ) )
			VAR _FillW = MIN ( 1, MAX ( 0, _V ) ) * 223.3
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.3 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Statutory on time</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( _V * 100, "0.0", "en-US" ) & "%</text>" &
			"<rect x='20' y='102' width='224.3' height='4' rx='2' fill='#222227'/>" &
			"<rect x='17' y='99' width='" & FORMAT ( _FillW + 6, "0.0", "en-US" ) & "' height='10' rx='5' fill='" & _C & "' fill-opacity='0.12'/>" &
			"<rect x='20' y='102' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='4' rx='2' fill='" & _C & "'/>" &
			"<rect x='243.3' y='97' width='2' height='14' fill='#E4E4E7'/>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='" & _C & "'>" & _G & " " & FORMAT ( [Statutory Finished Late], "#,0", "en-US" ) & " finished late</text>" &
			"<text x='244.3' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>target 100%</text></svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: e29407ce-3e38-5eb6-953b-27a20e338b47

	/// KPI 5: PM compliance against the 90% target.
	/// Expected: "81.8%", amber bar, "● −8.2 pts", "target 90%"
	measure 'HTML PM KPI Compliance' =
			VAR _V = [PM Compliance %]
			VAR _C = IF ( _V >= 0.9, "#4ADE80", IF ( _V >= 0.8, "#FBBF24", "#F87171" ) )
			VAR _G = IF ( _V >= 0.9, "&#10003;", IF ( _V >= 0.8, "&#9679;", "&#9650;" ) )
			VAR _Pts = ( _V - 0.9 ) * 100
			VAR _FillW = MIN ( 1, MAX ( 0, _V ) ) * 224.4
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.4 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>PM compliance</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( _V * 100, "0.0", "en-US" ) & "%</text>" &
			"<rect x='20' y='102' width='224.4' height='4' rx='2' fill='#222227'/>" &
			"<rect x='17' y='99' width='" & FORMAT ( _FillW + 6, "0.0", "en-US" ) & "' height='10' rx='5' fill='" & _C & "' fill-opacity='0.12'/>" &
			"<rect x='20' y='102' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='4' rx='2' fill='" & _C & "'/>" &
			"<rect x='" & FORMAT ( 19 + 0.9 * 224.4, "0.0", "en-US" ) & "' y='97' width='2' height='14' fill='#E4E4E7'/>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='" & _C & "'>" & _G & " " & IF ( _Pts < 0, "&#8722;", "+" ) & FORMAT ( ABS ( _Pts ), "0.0", "en-US" ) & " pts</text>" &
			"<text x='244.4' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>target 90%</text></svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: bb2bf544-1038-5e04-bb6b-cabce35e149a

	/// Card: what statutory work is overdue right now - the five oldest open inspection + safety jobs.
	/// Expected first row: 1035067 · VALVE-00470 · Replace faulty emergency stop · SAF · awaiting approval · 81 d
	measure 'HTML PM Overdue List' =
			VAR _N = [Statutory Overdue Today]
			VAR _Rows =
			    TOPN (
			        5,
			        CALCULATETABLE (
			            SELECTCOLUMNS (
			                FactWorkOrder,
			                "@wo", FactWorkOrder[WONUM], "@a", FactWorkOrder[ASSETNUM], "@t", FactWorkOrder[DESCRIPTION],
			                "@ty", FactWorkOrder[WORKTYPE], "@s", FactWorkOrder[STATUS], "@d", FactWorkOrder[DaysOverdue], "@site", FactWorkOrder[SITEID]
			            ),
			            FactWorkOrder[IsOpen] = 1, FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" }, NOT ISBLANK ( FactWorkOrder[DaysOverdue] ), REMOVEFILTERS ( DimDate )
			        ),
			        [@d], DESC, [@wo], ASC
			    )
			VAR _Max = MAX ( MAXX ( _Rows, [@d] ), 1 )
			VAR _K = ADDCOLUMNS ( _Rows, "@k", VAR _d = [@d] VAR _w = [@wo] RETURN COUNTROWS ( FILTER ( _Rows, [@d] > _d || ( [@d] = _d && [@wo] < _w ) ) ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1092 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>What statutory work is overdue right now?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>open inspection + safety jobs past target date &#183; oldest first</text>" &
			"<text x='1070' y='36' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#93C5FD'>All " & _N & " &#8594;</text>" &
			"<g font-family='Consolas' font-size='10.5' letter-spacing='0.4' fill='#5C5C66'><text x='22' y='83'>WO</text><text x='122' y='83'>ASSET</text><text x='304' y='83'>TASK</text><text x='728' y='83'>TYPE</text><text x='796' y='83'>STATUS</text><text x='1070' y='83' text-anchor='end'>DAYS OVERDUE</text></g>" &
			"<line x1='22' x2='1070' y1='91.5' y2='91.5' stroke='#232327'/>" &
			CONCATENATEX (
			    _K,
			    VAR _c = 115 + 46 * [@k]
			    VAR _st = SWITCH ( [@s], "WAPPR", "awaiting approval", "APPR", "not started", "INPRG", "in progress", [@s] )
			    VAR _sc = SWITCH ( [@s], "WAPPR", "#FBBF24", "APPR", "#A1A1AA", "INPRG", "#93C5FD", "#A1A1AA" )
			    VAR _sitec = SWITCH ( [@site], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" )
			    VAR _task = IF ( LEN ( [@t] ) > 54, LEFT ( [@t], 52 ) & "&#8230;", [@t] )
			    VAR _asset = IF ( ISBLANK ( [@a] ) || [@a] = "" || [@a] = "(none)", "location only", [@a] )
			    RETURN
			    "<text x='22' y='" & ( _c + 4 ) & "' font-family='Consolas' font-size='13' fill='#A1A1AA'>" & [@wo] & "</text>" &
			    "<circle cx='126' cy='" & _c & "' r='4' fill='" & _sitec & "'/>" &
			    "<text x='138' y='" & ( _c + 4 ) & "' font-family='Consolas' font-size='13' fill='#EDEDEF'>" & _asset & "</text>" &
			    "<text x='304' y='" & ( _c + 5 ) & "' font-family='Segoe UI' font-size='14' fill='#EDEDEF'>" & _task & "</text>" &
			    "<rect x='728.5' y='" & ( _c - 8.5 ) & "' width='" & FORMAT ( 12 + LEN ( [@ty] ) * 5.8, "0.0", "en-US" ) & "' height='17' rx='5' fill='none' stroke='#33333A'/>" &
			    "<text x='734' y='" & ( _c + 4 ) & "' font-family='Consolas' font-size='10.5' fill='#B4B4BC'>" & [@ty] & "</text>" &
			    "<text x='796' y='" & ( _c + 4 ) & "' font-family='Consolas' font-size='13' fill='" & _sc & "'>" & _st & "</text>" &
			    "<text x='1070' y='" & ( _c - 1 ) & "' text-anchor='end' font-family='Consolas' font-size='13' font-weight='600' fill='#F87171'>" & [@d] & " d</text>" &
			    "<rect x='960' y='" & ( _c + 9 ) & "' width='110' height='3' rx='1.5' fill='#222227'/>" &
			    "<rect x='960' y='" & ( _c + 9 ) & "' width='" & FORMAT ( [@d] / _Max * 110, "0.0", "en-US" ) & "' height='3' rx='1.5' fill='#F87171'/>" &
			    IF ( [@k] < COUNTROWS ( _Rows ) - 1, "<line x1='22' x2='1070' y1='" & ( _c + 23.5 ) & "' y2='" & ( _c + 23.5 ) & "' stroke='#1C1C20'/>" ),
			    "", [@k], ASC
			) & "</svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: 37a0e271-03d6-5bae-9afb-c36dcbb49245

	/// Card: where is it piling up - statutory jobs overdue today by days past target, against what
	/// falls due in the next 30 days. Expected: Houston 23 / 26, Aurora 10 / 5, Bedford 7 / 7
	measure 'HTML PM Pile Up' =
			VAR _T =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@v", [Statutory Overdue Today],
			        "@b1", [Statutory Overdue 1-7 Days] + 0,
			        "@b2", [Statutory Overdue 8-30 Days] + 0,
			        "@b3", [Statutory Overdue 31+ Days] + 0,
			        "@due", [Statutory Due Next 30 Days],
			        "@o", SWITCH ( DimSite[SITEID], "HOUSTON", 1, "AURORA", 2, "BEDFORD", 3, 9 ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _Max = MAX ( MAXX ( _T, [@v] ), 1 )
			VAR _Rows = ADDCOLUMNS ( _T, "@k", VAR _o = [@o] RETURN COUNTROWS ( FILTER ( _T, [@o] < _o ) ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 470 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Where is it piling up?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>statutory jobs overdue today vs due in the next 30 days</text>" &
			"<text x='364' y='83' text-anchor='end' font-family='Consolas' font-size='12' fill='#A1A1AA'>overdue</text>" &
			"<text x='448' y='83' text-anchor='end' font-family='Consolas' font-size='12' fill='#A1A1AA'>due 30 d</text>" &
			CONCATENATEX (
			    _Rows,
			    VAR _c = 123 + 52 * [@k]
			    VAR _W = [@v] / _Max * 146
			    VAR _w1 = DIVIDE ( [@b1], [@v] ) * _W
			    VAR _w2 = DIVIDE ( [@b2], [@v] ) * _W
			    VAR _w3 = DIVIDE ( [@b3], [@v] ) * _W
			    RETURN
			    "<circle cx='26' cy='" & _c & "' r='7' fill='" & [@c] & "' fill-opacity='0.25'/>" &
			    "<circle cx='26' cy='" & _c & "' r='4' fill='" & [@c] & "'/>" &
			    "<text x='38' y='" & ( _c + 5 ) & "' font-family='Segoe UI' font-size='15' fill='#EDEDEF'>" & [@n] & "</text>" &
			    IF ( [@b1] > 0, "<rect x='132' y='" & ( _c - 8 ) & "' width='" & FORMAT ( MAX ( _w1 - 2, 1 ), "0.0", "en-US" ) & "' height='16' rx='3' fill='#FDE68A'/>" ) &
			    IF ( [@b2] > 0, "<rect x='" & FORMAT ( 132 + _w1, "0.0", "en-US" ) & "' y='" & ( _c - 8 ) & "' width='" & FORMAT ( MAX ( _w2 - 2, 1 ), "0.0", "en-US" ) & "' height='16' rx='3' fill='#FBBF24'/>" ) &
			    IF ( [@b3] > 0, "<rect x='" & FORMAT ( 132 + _w1 + _w2, "0.0", "en-US" ) & "' y='" & ( _c - 8 ) & "' width='" & FORMAT ( MAX ( _w3, 1 ), "0.0", "en-US" ) & "' height='16' rx='3' fill='#F87171'/>" ) &
			    "<text x='364' y='" & ( _c + 8 ) & "' text-anchor='end' font-family='Segoe UI' font-size='24' font-weight='600' fill='#F87171'>" & [@v] & "</text>" &
			    "<text x='448' y='" & ( _c + 8 ) & "' text-anchor='end' font-family='Segoe UI' font-size='24' font-weight='600' fill='#FBBF24'>" & [@due] & "</text>",
			    "", [@o], ASC
			) &
			"<g font-family='Consolas' font-size='12' fill='#A1A1AA'><text x='22' y='275'>days overdue:</text>" &
			"<rect x='126' y='266' width='10' height='10' rx='3' fill='#FDE68A'/><text x='142' y='275'>1&#8211;7</text>" &
			"<rect x='194' y='266' width='10' height='10' rx='3' fill='#FBBF24'/><text x='210' y='275'>8&#8211;30</text>" &
			"<rect x='270' y='266' width='10' height='10' rx='3' fill='#F87171'/><text x='286' y='275'>31+</text></g></svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: 1544a599-40fc-5a1d-b92c-37e7d84d1ae9

	/// Card: is statutory compliance improving - on-time % of inspection + safety jobs by due quarter,
	/// one smooth glowing line per site, dashed target at 100%, value labels at the line ends.
	/// Follows the year buttons (only quarters ending inside the selected years are drawn).
	/// Expected last points (Jun 2026): Bedford 92.0%, Aurora 89.3%, Houston 80.0%
	measure 'HTML PM Quarterly' =
			VAR _AsOf = [Data As Of Date]
			VAR _FirstFull = EDATE ( CALCULATE ( MIN ( FactWorkOrder[ReportDate] ), REMOVEFILTERS () ), 3 )
			VAR _SelFrom = MIN ( DimDate[Date] )
			VAR _SelTo = MAX ( DimDate[Date] )
			// quarter ends from the first full quarter to the cut-off, inside the selected years
			VAR _AllQ =
			    FILTER (
			        ADDCOLUMNS ( GENERATESERIES ( 0, 60, 1 ), "@qe", EOMONTH ( _FirstFull, [Value] ) ),
			        MONTH ( [@qe] ) IN { 3, 6, 9, 12 }
			            && EOMONTH ( [@qe], -3 ) + 1 >= _FirstFull
			            && [@qe] <= _AsOf
			            && [@qe] >= _SelFrom
			            && [@qe] <= _SelTo
			    )
			VAR _Q = ADDCOLUMNS ( _AllQ, "@i", VAR _q = [@qe] RETURN COUNTROWS ( FILTER ( _AllQ, [@qe] < _q ) ) )
			VAR _NQ = COUNTROWS ( _Q )
			VAR _PW = 1030 - 46 - 130
			VAR _Step = DIVIDE ( _PW, MAX ( _NQ - 1, 1 ) )
			VAR _Vals =
			    ADDCOLUMNS (
			        CROSSJOIN ( VALUES ( DimSite[SITEID] ), _Q ),
			        "@v", CALCULATE ( [Statutory On-Time %], REMOVEFILTERS ( DimDate ),
			                DATESBETWEEN ( DimDate[Date], EOMONTH ( [@qe], -3 ) + 1, [@qe] ),
			                USERELATIONSHIP ( DimDate[Date], FactWorkOrder[TargCompDate] ) )
			    )
			VAR _Lo = MIN ( 0.6, FLOOR ( MINX ( _Vals, [@v] ), 0.1 ) )
			VAR _Hi = 1.06
			VAR _Sites =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) ),
			        "@last", VAR _s = DimSite[SITEID] RETURN MAXX ( FILTER ( _Vals, DimSite[SITEID] = _s && [@i] = _NQ - 1 ), [@v] )
			    )
			VAR _E0 =
			    ADDCOLUMNS ( _Sites, "@ey", 68 + ( _Hi - [@last] ) / ( _Hi - _Lo ) * 194 )
			VAR _Ends =
			    ADDCOLUMNS ( _E0, "@rk", VAR _y = [@ey] VAR _s = DimSite[SITEID] RETURN COUNTROWS ( FILTER ( _E0, [@ey] < _y || ( [@ey] = _y && DimSite[SITEID] < _s ) ) ) )
			// end labels top to bottom, at least 18px apart: y(k) = max over j <= k of ( ey(j) + 18 * (k - j) )
			VAR _Lab =
			    ADDCOLUMNS (
			        _Ends,
			        "@ly", VAR _k = [@rk] RETURN MAXX ( FILTER ( _Ends, [@rk] <= _k ), [@ey] + 18 * ( _k - [@rk] ) )
			    )
			VAR _Grid =
			    CONCATENATEX (
			        FILTER ( { 0.6, 0.7, 0.8, 0.9, 1.0, 0.5, 0.4, 0.3, 0.2, 0.1, 0 }, [Value] >= _Lo - 0.001 ),
			        VAR _gy = 68 + ( _Hi - [Value] ) / ( _Hi - _Lo ) * 194
			        RETURN
			        "<line x1='68' x2='" & FORMAT ( 68 + _PW, "0.0", "en-US" ) & "' y1='" & FORMAT ( _gy, "0.0", "en-US" ) & "' y2='" & FORMAT ( _gy, "0.0", "en-US" ) & "' stroke='#1D1D21'/>" &
			        "<text x='58' y='" & FORMAT ( _gy + 4, "0.0", "en-US" ) & "' text-anchor='end' font-family='Consolas' font-size='12' fill='#5C5C66'>" & FORMAT ( [Value] * 100, "0", "en-US" ) & "</text>",
			        ""
			    ) &
			    CONCATENATEX (
			        FILTER ( _Q, MOD ( [@i], 2 ) = 0 || [@i] = _NQ - 1 ),
			        "<text x='" & FORMAT ( 68 + [@i] * _Step, "0.0", "en-US" ) & "' y='282' text-anchor='middle' font-family='Consolas' font-size='12' fill='#5C5C66'>" &
			            FORMAT ( [@qe], "yy", "en-US" ) & " Q" & ROUNDUP ( MONTH ( [@qe] ) / 3, 0 ) & "</text>",
			        ""
			    )
			VAR _Ty = 68 + ( _Hi - 1 ) / ( _Hi - _Lo ) * 194
			VAR _Lines =
			    CONCATENATEX (
			        _Sites,
			        VAR _s = DimSite[SITEID]
			        VAR _c = [@c]
			        VAR _P =
			            SELECTCOLUMNS (
			                FILTER ( _Vals, DimSite[SITEID] = _s ),
			                "@i", [@i],
			                "@x", 68 + [@i] * _Step,
			                "@y", 68 + ( _Hi - [@v] ) / ( _Hi - _Lo ) * 194
			            )
			        VAR _D = ADDCOLUMNS ( _P, "@d", VAR _i = [@i] RETURN DIVIDE ( MAXX ( FILTER ( _P, [@i] = _i + 1 ), [@y] ) - [@y], _Step ) )
			        VAR _T =
			            ADDCOLUMNS (
			                _D,
			                "@m",
			                    VAR _i = [@i]
			                    VAR _a = MAXX ( FILTER ( _D, [@i] = _i - 1 ), [@d] )
			                    VAR _b = [@d]
			                    RETURN IF ( _i = 0, _b, IF ( _i = _NQ - 1, _a, IF ( _a * _b <= 0, 0, ( _a + _b ) / 2 * MIN ( 1, 3 * MIN ( ABS ( _a ), ABS ( _b ) ) / MAX ( ABS ( ( _a + _b ) / 2 ), 1e-9 ) ) ) ) )
			            )
			        VAR _h3 = _Step / 3
			        VAR _Path =
			            "M68," & FORMAT ( MAXX ( FILTER ( _T, [@i] = 0 ), [@y] ), "0.0", "en-US" ) &
			            CONCATENATEX (
			                FILTER ( _T, [@i] < _NQ - 1 ),
			                VAR _i = [@i]
			                VAR _x2 = MAXX ( FILTER ( _T, [@i] = _i + 1 ), [@x] )
			                VAR _y2 = MAXX ( FILTER ( _T, [@i] = _i + 1 ), [@y] )
			                VAR _m2 = MAXX ( FILTER ( _T, [@i] = _i + 1 ), [@m] )
			                RETURN
			                " C" & FORMAT ( [@x] + _h3, "0.0", "en-US" ) & "," & FORMAT ( [@y] + [@m] * _h3, "0.0", "en-US" ) & " " &
			                FORMAT ( _x2 - _h3, "0.0", "en-US" ) & "," & FORMAT ( _y2 - _m2 * _h3, "0.0", "en-US" ) & " " &
			                FORMAT ( _x2, "0.0", "en-US" ) & "," & FORMAT ( _y2, "0.0", "en-US" ),
			                "", [@i], ASC
			            )
			        VAR _ex = FORMAT ( 68 + ( _NQ - 1 ) * _Step, "0.0", "en-US" )
			        VAR _ey = FORMAT ( MAXX ( FILTER ( _T, [@i] = _NQ - 1 ), [@y] ), "0.0", "en-US" )
			        RETURN
			        "<path d='" & _Path & "' fill='none' stroke='" & _c & "' stroke-width='14.4' stroke-opacity='0.06' stroke-linecap='round'/>" &
			        "<path d='" & _Path & "' fill='none' stroke='" & _c & "' stroke-width='7.2' stroke-opacity='0.16' stroke-linecap='round'/>" &
			        "<path d='" & _Path & "' fill='none' stroke='" & _c & "' stroke-width='2.4' stroke-linecap='round'/>" &
			        "<circle cx='" & _ex & "' cy='" & _ey & "' r='4' fill='" & _c & "'/>",
			        ""
			    )
			VAR _Labels =
			    CONCATENATEX (
			        _Lab,
			        "<text x='" & FORMAT ( 68 + _PW + 12, "0.0", "en-US" ) & "' y='" & FORMAT ( [@ly] + 4, "0.0", "en-US" ) & "' font-family='Segoe UI' font-size='13' fill='" & [@c] & "'>" & [@n] &
			            " <tspan font-family='Consolas' font-weight='600'>" & FORMAT ( [@last] * 100, "0.0", "en-US" ) & "%</tspan></text>",
			        ""
			    )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1092 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Is statutory compliance improving?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>inspection + safety jobs finished on time, by quarter</text>" &
			_Grid &
			"<line x1='68' x2='" & FORMAT ( 68 + _PW, "0.0", "en-US" ) & "' y1='" & FORMAT ( _Ty, "0.0", "en-US" ) & "' y2='" & FORMAT ( _Ty, "0.0", "en-US" ) & "' stroke='#FBBF24' stroke-width='1.3' stroke-dasharray='5 5'/>" &
			"<text x='74' y='" & FORMAT ( _Ty - 7, "0.0", "en-US" ) & "' font-family='Consolas' font-size='11' fill='#FBBF24'>target 100%</text>" &
			_Lines & _Labels & "</svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: 3652434a-7e4d-5bef-b889-63bdd4e5792a

	/// Card: which PM schedules keep slipping - the four schedules (12+ finished runs) with the
	/// lowest on-time rate. Expected first rows: PM-00305 · XFMR-00400 7 of 12, PM-00472 · TANK-00606 7 of 12
	measure 'HTML PM Slipping' =
			VAR _Below = [PM Schedules Below 80%]
			VAR _S =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( FactWorkOrder[PMNUM] ), FactWorkOrder[IsPM] = 1, NOT ISBLANK ( FactWorkOrder[PMNUM] ) ),
			            "@runs", CALCULATE ( SUM ( FactWorkOrder[IsPMCompleted] ) ),
			            "@ok", CALCULATE ( SUM ( FactWorkOrder[IsPMOnTime] ) ),
			            "@a", CALCULATE ( MAX ( FactWorkOrder[ASSETNUM] ) ),
			            "@site", CALCULATE ( MAX ( FactWorkOrder[SITEID] ) ),
			            "@t", CALCULATE ( MAX ( FactWorkOrder[DESCRIPTION] ) )
			        ),
			        [@runs] >= 12
			    )
			VAR _Top = TOPN ( 4, ADDCOLUMNS ( _S, "@r", DIVIDE ( [@ok], [@runs] ) ), [@r], ASC, FactWorkOrder[PMNUM], ASC )
			VAR _K = ADDCOLUMNS ( _Top, "@k", VAR _r = [@r] VAR _p = FactWorkOrder[PMNUM] RETURN COUNTROWS ( FILTER ( _Top, [@r] < _r || ( [@r] = _r && FactWorkOrder[PMNUM] < _p ) ) ) )
			VAR _OneSite = IF ( COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _Top, "s", [@site] ) ) ) = 1, MAXX ( _Top, [@site] ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 470 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Which PM schedules keep slipping?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>schedules with 12+ runs" & IF ( _OneSite <> "", " &#183; all at " & UPPER ( LEFT ( _OneSite, 1 ) ) & LOWER ( MID ( _OneSite, 2, 50 ) ) ) & "</text>" &
			"<text x='448' y='36' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#93C5FD'>" & _Below & " below 80% &#8594;</text>" &
			"<g font-family='Consolas' font-size='10.5' letter-spacing='0.4' fill='#5C5C66'><text x='22' y='82'>PM SCHEDULE</text><text x='328' y='82'>LATE</text></g>" &
			"<line x1='22' x2='448' y1='91.5' y2='91.5' stroke='#232327'/>" &
			CONCATENATEX (
			    _K,
			    VAR _y = 116 + 55 * [@k]
			    VAR _late = [@runs] - [@ok]
			    VAR _sitec = SWITCH ( [@site], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" )
			    VAR _t = IF ( LEN ( [@t] ) > 38, LEFT ( [@t], 37 ) & "&#8230;", [@t] )
			    RETURN
			    "<circle cx='26' cy='" & ( _y - 4 ) & "' r='4' fill='" & _sitec & "'/>" &
			    "<text x='38' y='" & _y & "' font-family='Consolas' font-size='13' fill='#EDEDEF'>" & FactWorkOrder[PMNUM] & " &#183; " & [@a] & "</text>" &
			    "<text x='38' y='" & ( _y + 18 ) & "' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & _t & "</text>" &
			    "<text x='328' y='" & ( _y + 1 ) & "' font-family='Consolas' font-size='13' fill='#F87171'>" & _late & " of " & [@runs] & "</text>" &
			    "<rect x='328' y='" & ( _y + 10 ) & "' width='120' height='3' rx='1.5' fill='#222227'/>" &
			    "<rect x='328' y='" & ( _y + 10 ) & "' width='" & FORMAT ( DIVIDE ( _late, [@runs] ) * 120, "0.0", "en-US" ) & "' height='3' rx='1.5' fill='#F87171'/>" &
			    IF ( [@k] < COUNTROWS ( _Top ) - 1, "<line x1='22' x2='448' y1='" & ( _y + 31.5 ) & "' y2='" & ( _y + 31.5 ) & "' stroke='#1C1C20'/>" ),
			    "", [@k], ASC
			) & "</svg>"
		displayFolder: Report Cards\2 PM & Compliance
		lineageTag: 6d345e42-d6a0-5d84-9be7-09838b09be24

	/// Top bar of the Reliability page: page name with icon on the left, data cut-off on the right.
	measure 'HTML Top Bar Reliability' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1648 56' width='100%' style='display:block;max-height:100vh'>" &
			"<g transform='translate(36,19)' fill='none' stroke='#C8C8CF' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><path d='M3 12h4l2.5-6 5 12 2.5-6H21'/></g></g>" &
			"<text x='64' y='33' font-family='Segoe UI' font-size='15' fill='#C8C8CF'>Reliability</text>" &
			"<text x='1612' y='32' text-anchor='end' font-family='Consolas' font-size='12' fill='#5C5C66'>data as of " & FORMAT ( [Data As Of Date], "d mmm yyyy", "en-US" ) & "</text></svg>"
		displayFolder: Report Cards\0 Chrome
		lineageTag: 0ad5238d-72f0-5a72-b446-769485391d97

	/// Top bar of the Planning page: page name with icon on the left, data cut-off on the right.
	measure 'HTML Top Bar Planning' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1648 56' width='100%' style='display:block;max-height:100vh'>" &
			"<g transform='translate(36,19)' fill='none' stroke='#C8C8CF' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4'/></g></g>" &
			"<text x='64' y='33' font-family='Segoe UI' font-size='15' fill='#C8C8CF'>Planning</text>" &
			"<text x='1612' y='32' text-anchor='end' font-family='Consolas' font-size='12' fill='#5C5C66'>data as of " & FORMAT ( [Data As Of Date], "d mmm yyyy", "en-US" ) & "</text></svg>"
		displayFolder: Report Cards\0 Chrome
		lineageTag: a849f009-ab56-5bbc-bcc0-333d8d48cf19

	/// Top bar of the Information page: page name with icon on the left, data cut-off on the right.
	measure 'HTML Top Bar Information' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1648 56' width='100%' style='display:block;max-height:100vh'>" &
			"<g transform='translate(36,19)' fill='none' stroke='#C8C8CF' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><circle cx='12' cy='12' r='9'/><path d='M12 11v6M12 7.5v.5'/></g></g>" &
			"<text x='64' y='33' font-family='Segoe UI' font-size='15' fill='#C8C8CF'>Information</text>" &
			"<text x='1612' y='32' text-anchor='end' font-family='Consolas' font-size='12' fill='#5C5C66'>data as of " & FORMAT ( [Data As Of Date], "d mmm yyyy", "en-US" ) & "</text></svg>"
		displayFolder: Report Cards\0 Chrome
		lineageTag: 465ae2b4-feb1-5f57-94cf-754b9449c731

	/// Page list in the sidebar, Reliability highlighted. Transparent buttons on top do the navigating.
	measure 'HTML Nav Reliability' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 239 200' width='100%' style='display:block;max-height:100vh'>" &
