			"<g transform='translate(11,90)' fill='none' stroke='#8B8B93' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><path d='M3 12h4l2.5-6 5 12 2.5-6H21'/></g></g>" &
			"<text x='40' y='104' font-family='Segoe UI' font-size='15' fill='#B4B4BC'>Reliability</text>" &
			"<g transform='translate(11,130)' fill='none' stroke='#8B8B93' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><rect x='3' y='5' width='18' height='16' rx='2'/><path d='M3 10h18M8 3v4M16 3v4'/></g></g>" &
			"<text x='40' y='144' font-family='Segoe UI' font-size='15' fill='#B4B4BC'>Planning</text>" &
			"<rect x='0.5' y='160.5' width='238' height='37' rx='8' fill='#1C1C20' stroke='#2A2A30'/>" &
			"<g transform='translate(11,170)' fill='none' stroke='#EDEDEF' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><circle cx='12' cy='12' r='9'/><path d='M12 11v6M12 7.5v.5'/></g></g>" &
			"<text x='40' y='184' font-family='Segoe UI' font-size='15' fill='#EDEDEF'>Information</text>" &
