// =============================================================================
// DAX MEASURES - Maximo maintenance KPIs
// =============================================================================
//
// Every expected value below was computed independently from the source CSVs by
// verify_measures.py, which rebuilds this exact star schema in pandas and
// applies these exact definitions. If a measure disagrees with its expected
// value, the measure is wrong - not the baseline.
//
// NOT YET VERIFIED: DAX syntax and engine evaluation. These definitions were
// validated as logic, not executed in Analysis Services. Check each measure
// against the expected values on first load.
//
// -----------------------------------------------------------------------------
// RELATIONSHIPS REQUIRED (all single-direction, one-to-many from dim to fact)
// -----------------------------------------------------------------------------
//   ACTIVE
//     DimDate[Date]              -> FactWorkOrder[ReportDate]
//     DimDate[Date]              -> FactLabour[TransDate]
//     DimDate[Date]              -> FactMaterial[TransDate]
//     DimDate[Date]              -> FactDowntime[DowntimeStartDate]
//     DimDate[Date]              -> FactFailure[FailureDate]
//     DimDate[Date]              -> FactMeterReading[ReadingDate]
//     DimAsset[ASSETNUM]         -> FactWorkOrder[ASSETNUM]
//     DimAsset[ASSETNUM]         -> FactDowntime[ASSETNUM]
//     DimAsset[ASSETNUM]         -> FactFailure[ASSETNUM]
//     DimAsset[ASSETNUM]         -> FactMeterReading[ASSETNUM]
//     DimLocation[LOCATION]      -> FactWorkOrder[LOCATION]
//     DimLocation[LOCATION]      -> FactMaterial[LOCATION]
//     DimSite[SITEID]            -> FactWorkOrder[SITEID]
//     DimSite[SITEID]            -> FactDowntime[SITEID]
//     DimSite[SITEID]            -> FactFailure[SITEID]
//     DimWorkType[WORKTYPE]      -> FactWorkOrder[WORKTYPE]
//     DimStatus[STATUS]          -> FactWorkOrder[STATUS]
//     DimCraft[CRAFT]            -> FactLabour[CRAFT]
//     DimLabor[LABORCODE]        -> FactLabour[LABORCODE]
//     DimItem[ITEMNUM]           -> FactMaterial[ITEMNUM]
//     DimFailureCode[ProblemCode]-> FactFailure[PROBLEMCODE]
//
//   INACTIVE (activated by USERELATIONSHIP inside specific measures)
//     DimDate[Date]              -> FactWorkOrder[TargCompDate]
//     DimDate[Date]              -> FactWorkOrder[ActFinishDate]
//
//   UNRELATED (deliberately)
//     ScheduleTolerance   - what-if table
//     DimLabor -> DimSite - see [Weekly Craft Capacity (Hours)]; TREATAS is used
//                           instead of a relationship to avoid an ambiguous path
//                           DimSite -> FactLabour and DimSite -> DimLabor ->
//                           FactLabour.
//
//   DO NOT create fact-to-fact relationships (FactWorkOrder -> FactLabour etc).
//   Combined with DimDate and DimSite reaching both tables that produces two
//   filter paths to the same rows. WORKTYPE and ASSETNUM are already merged onto
//   the transaction facts in Power Query for this reason.
//
// -----------------------------------------------------------------------------
// EXPECTED VALUES - whole dataset, no filters
// -----------------------------------------------------------------------------
//   Measure                        BEDFORD      HOUSTON       AURORA          ALL
//   Work Orders                     10,462       19,474       10,999       40,935
//   Reactive Maintenance %           21.0%        44.8%        30.9%        35.0%
//   PM Compliance %                  93.2%        69.3%        85.2%        81.8%
//   Schedule Compliance % (tol 2)    85.3%        60.7%        76.1%        71.9%
//   MTTR (Hours)                      9.04        15.56        10.82        13.45
//   Total Maintenance Cost      $6,020,214  $15,435,868   $7,250,332  $28,706,414
//   Backlog Hours                  2,860.6      9,739.1      3,203.2     15,803.0
//   Weekly Craft Capacity            1,040          960          720        2,720
//   Backlog Weeks                     2.75        10.14         4.45         5.81
//   MTBF (Hours)                     4,006          908        1,956        1,643
//   Asset Availability %            99.88%       99.05%       99.71%       99.55%
// =============================================================================


// -----------------------------------------------------------------------------
// BASE
// -----------------------------------------------------------------------------

// Cancelled work orders carry no actuals. Excluding them once, here, keeps every
// downstream measure consistent.
Work Orders =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsCancelled] = 0
)


// -----------------------------------------------------------------------------
// 1. REACTIVE MAINTENANCE %
//    (CM + EM) / all non-cancelled work orders.
//    Note a cancelled corrective work order still has IsReactive = 1, so the
//    cancelled filter is required on the numerator too.
//    Expected: 35.0% all sites
// -----------------------------------------------------------------------------
Reactive Maintenance % =
VAR _Reactive =
    CALCULATE (
        SUM ( FactWorkOrder[IsReactive] ),
        FactWorkOrder[IsCancelled] = 0
    )
RETURN
    DIVIDE ( _Reactive, [Work Orders] )


// -----------------------------------------------------------------------------
// 2. PM COMPLIANCE %
//    Completed PM work orders finished on or before TARGCOMPDATE.
//    Both numerator and denominator are pre-computed 0/1 columns in Power Query,
//    so this measure needs no filter arguments at all - a cancelled or still-open
//    PM has IsPMCompleted = 0 by construction.
//    The comparison behind IsPMOnTime uses DATE-only columns. Comparing raw
//    datetimes understates this by 22.1 points on this dataset (81.8% -> 59.7%).
//    Expected: 81.8% all sites
// -----------------------------------------------------------------------------
PM Compliance % =
DIVIDE (
    SUM ( FactWorkOrder[IsPMOnTime] ),
    SUM ( FactWorkOrder[IsPMCompleted] )
)


// PM compliance is conventionally reported against the period the work was DUE,
// not the period it was reported in. Grand totals are identical; the two differ
// as soon as you put a month on the axis. Decide which one you mean and say so
// on the report face.
PM Compliance % (by Due Date) =
CALCULATE (
    [PM Compliance %],
    USERELATIONSHIP ( DimDate[Date], FactWorkOrder[TargCompDate] )
)


// -----------------------------------------------------------------------------
// 3. SCHEDULE COMPLIANCE %
//    Scheduled work started within the tolerance window of SCHEDSTART.
//    This KPI is highly sensitive to the tolerance you pick - on this dataset
//    the all-sites figure moves from 21.6% (same day) to 87.0% (within a week).
//    That sensitivity is the point: expose the tolerance, never bury it.
//
//    SELECTEDVALUE's second argument is the default. Without it the measure
//    returns BLANK at a grand total or when nothing is selected, because
//    SELECTEDVALUE collapses when more than one row is in context.
//    Expected at tolerance 2: 71.9% all sites
// -----------------------------------------------------------------------------
Schedule Compliance % =
VAR _Tolerance = SELECTEDVALUE ( ScheduleTolerance[Days], 2 )
VAR _Scheduled =
    CALCULATE (
        COUNTROWS ( FactWorkOrder ),
        FactWorkOrder[IsScheduled] = 1,
        FactWorkOrder[IsCancelled] = 0
    )
VAR _OnSchedule =
    CALCULATE (
        COUNTROWS ( FactWorkOrder ),
        FactWorkOrder[IsScheduled] = 1,
        FactWorkOrder[IsCancelled] = 0,
        FactWorkOrder[SchedStartVarianceDays] <= _Tolerance
    )
RETURN
    DIVIDE ( _OnSchedule, _Scheduled )


// -----------------------------------------------------------------------------
// 4. MTTR (MEAN TIME TO REPAIR)
//    Elapsed downtime hours per downtime event.
//    FactDowntime[DOWNTIME] is wall-clock elapsed time. Do NOT substitute
//    ACTLABHRS: three technicians for four hours is 12 labour hours but 4 hours
//    of downtime, which inflates MTTR by roughly the crew size.
//    Expected: 13.45 h all sites
// -----------------------------------------------------------------------------
MTTR (Hours) =
DIVIDE (
    SUM ( FactDowntime[DOWNTIME] ),
    COUNTROWS ( FactDowntime )
)


// -----------------------------------------------------------------------------
// 5. TOTAL MAINTENANCE COST
//    Labour + material + tool + service, at work-order level.
//    Work-order level is deliberate, not lazy: ACTTOOLCOST and ACTSERVCOST have
//    no transaction table, so summing FactLabour and FactMaterial would silently
//    drop 12.6% of spend. Labour and material do reconcile to the cent against
//    the transaction tables - see [Cost Reconciliation Check].
//    Expected: $28,706,414 all sites
// -----------------------------------------------------------------------------
Total Maintenance Cost =
CALCULATE (
    SUM ( FactWorkOrder[ActualTotalCost] ),
    FactWorkOrder[IsCancelled] = 0
)


// Should always return 0. If it does not, the fact tables are out of step.
Cost Reconciliation Check =
VAR _WOLabour = CALCULATE ( SUM ( FactWorkOrder[ACTLABCOST] ), REMOVEFILTERS () )
VAR _TxLabour = CALCULATE ( SUM ( FactLabour[LINECOST] ), REMOVEFILTERS () )
VAR _WOMaterial = CALCULATE ( SUM ( FactWorkOrder[ACTMATCOST] ), REMOVEFILTERS () )
VAR _TxMaterial = CALCULATE ( SUM ( FactMaterial[LINECOST] ), REMOVEFILTERS () )
RETURN
    ROUND ( _WOLabour - _TxLabour, 2 ) + ROUND ( _WOMaterial - _TxMaterial, 2 )


// -----------------------------------------------------------------------------
// 6. BACKLOG
//    Open estimated labour hours, expressed in weeks of available craft capacity.
//
//    IMPORTANT - this is CURRENT-STATE backlog, not a historical trend.
//    "Open" is an attribute of the row as it stands today (STATUS in WAPPR /
//    APPR / INPRG), so REMOVEFILTERS(DimDate) is required: without it, slicing
//    by month silently changes the meaning to "work orders REPORTED that month
//    that happen to still be open", which is a different and much smaller
//    number. Trending backlog properly means reconstructing daily open state
//    from WOSTATUS - a snapshot fact table, not this measure.
//
//    Capacity is NOT in the Maximo data. It is derived from active hands-on
//    labour headcount x 40 hours. Planners and supervisors are excluded because
//    they do not burn down the work-order backlog.
//    Expected: 15,803.0 hours / 2,720 hours = 5.81 weeks all sites
// -----------------------------------------------------------------------------
Backlog Hours =
CALCULATE (
    SUM ( FactWorkOrder[ESTLABHRS] ),
    FactWorkOrder[IsOpen] = 1,
    REMOVEFILTERS ( DimDate )
)


// TREATAS pushes the selected sites onto DimLabor without a relationship,
// avoiding the ambiguous path a DimSite -> DimLabor relationship would create.
Weekly Craft Capacity (Hours) =
VAR _Sites = VALUES ( DimSite[SITEID] )
RETURN
    CALCULATE (
        COUNTROWS ( DimLabor ) * 40,
        DimLabor[IsWrenchCraft] = 1,
        TREATAS ( _Sites, DimLabor[SITEID] )
    )


Backlog Weeks =
DIVIDE ( [Backlog Hours], [Weekly Craft Capacity (Hours)] )


// =============================================================================
// RELIABILITY MEASURES - THESE DEPEND ON A STATED ASSUMPTION
// =============================================================================
// MTBF and availability both need asset OPERATING hours. Maximo only knows
// those if a RUNHOURS meter is faithfully maintained; on this dataset only a
// subset of assets carry one. The assumption used below is:
//
//     operating hours = operating asset count x calendar hours - reported downtime
//
// Put that sentence on the report face. Do not present either measure as exact.
//
// Two consequences worth understanding before you show these to anyone:
//   * Calendar hours assume 24/7 operation. Most assets do not run 24/7, so
//     availability computed this way FLATTERS every site - which is why all
//     three land above 99% here despite very different reliability. If the
//     business has scheduled runtime, use that as the denominator instead.
//   * MTBF is far more discriminating than availability under this assumption:
//     Bedford at 4,006 hours vs Houston at 908 is a 4.4x gap that the
//     availability figures almost completely hide.
// =============================================================================

Operating Asset Count =
CALCULATE (
    DISTINCTCOUNT ( DimAsset[ASSETNUM] ),
    DimAsset[STATUS] = "OPERATING",
    DimAsset[ASSETNUM] <> "(none)"
)


// The one place with a hardcoded date. 2023-07-01 is this dataset's window
// start; ISPASTORTODAY already caps the upper bound at the window end. Change
// the literal if you change START_DATE in the generator config. It is written
// as a FILTER over DimDate rather than a constant so the measure still responds
// correctly to a date slicer.
Analysis Days =
COUNTROWS (
    FILTER (
        DimDate,
        DimDate[ISPASTORTODAY] = 1
            && DimDate[Date] >= DATE ( 2023, 7, 1 )
    )
)


Scheduled Asset Hours =
[Operating Asset Count] * [Analysis Days] * 24


// Expected: 1,643 h all sites (Bedford 4,006 / Houston 908 / Aurora 1,956)
MTBF (Hours) =
VAR _Scheduled = [Scheduled Asset Hours]
VAR _Downtime = SUM ( FactDowntime[DOWNTIME] )
VAR _Failures = COUNTROWS ( FactFailure )
RETURN
    DIVIDE ( _Scheduled - _Downtime, _Failures )


// Expected: 99.55% all sites. See the caveat above about calendar hours.
Asset Availability % =
VAR _Scheduled = [Scheduled Asset Hours]
VAR _Downtime = SUM ( FactDowntime[DOWNTIME] )
RETURN
    DIVIDE ( _Scheduled - _Downtime, _Scheduled )


// =============================================================================
// SUPPORTING MEASURES - useful on the report, not part of the core six
// =============================================================================

Open Work Orders =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    REMOVEFILTERS ( DimDate )
)


Failure Events =
COUNTROWS ( FactFailure )


Downtime Hours =
SUM ( FactDowntime[DOWNTIME] )


Actual Labour Hours =
CALCULATE (
    SUM ( FactWorkOrder[ACTLABHRS] ),
    FactWorkOrder[IsCancelled] = 0
)


// Planned vs reactive labour split. Relies on WORKTYPE having been merged onto
// FactLabour in Power Query - there is no fact-to-fact relationship to traverse.
Reactive Labour Hours =
CALCULATE (
    SUM ( FactLabour[TotalHours] ),
    FactLabour[WORKTYPE] IN { "CM", "EM" }
)


// SMRP metric: maintenance cost as a percent of replacement asset value.
// Best-in-class is 2-3% per year. This dataset runs at 6.0% overall
// (Bedford 4.0%, Houston 7.1%, Aurora 6.6%) - an underperforming portfolio,
// which is the story the data is built to tell.
Maintenance Cost % of RAV =
VAR _Cost = [Total Maintenance Cost]
VAR _RAV =
    CALCULATE (
        SUM ( DimAsset[REPLACECOST] ),
        DimAsset[ASSETNUM] <> "(none)"
    )
VAR _Years = DIVIDE ( [Analysis Days], 365.25 )
RETURN
    DIVIDE ( DIVIDE ( _Cost, _Years ), _RAV )


Mean Days to Complete =
AVERAGE ( FactWorkOrder[DaysToComplete] )
