// =============================================================================
// OVERVIEW + PM & COMPLIANCE PAGE MEASURES (dark redesign, Nov 2026)
// =============================================================================
//
// Feeds the first two pages of the redesign (assets/mockups/executive_v10 and
// pm_compliance_v8). Builds on the existing measures; changes none of them.
//
// "// @format" lines are read by scripts/add_measures.py as the formatString and
// are not copied into the description.
//
// Every expected value below was computed from data/*.csv with the model's
// rules (date-only comparisons, as-of 29 Jul 2026). If a measure disagrees,
// the measure is wrong.
//
// -----------------------------------------------------------------------------
// EXPECTED VALUES - no filters
// -----------------------------------------------------------------------------
//   Measure                        BEDFORD     AURORA    HOUSTON        ALL
//   Annual Maintenance Spend        $1.95M     $2.35M     $5.01M     $9.32M
//   Spend Above Benchmark               $0     $0.92M     $2.18M     $3.10M
//   Reactive Cost Share              46.2%      59.7%      69.1%      62.0%
//   Cost per Reactive Job           $1,301     $1,305     $1,278     $1,288
//   Cost per PM                       $256       $213       $232       $234
//   Statutory Finished Late             56        103        321        480
//   Statutory On-Time %              90.7%      83.7%      70.8%      79.5%
//   Reactive YoY %                   -2.3%     -21.4%      +4.7%      -2.6%
//   Statutory Overdue Today              7         10         23         40
//   Statutory Due Next 30 Days           7          5         26         38
//   PMs Overdue Today                  113        145        352        610
//
// Two figures differ from the mockup because the model compares dates, not
// date-times: the oldest overdue job is 81 days late (mockup 80) and 38
// statutory jobs fall due in the next 30 days (mockup 36).
// =============================================================================


// Length of the selected window in years. Turns period totals into annual rates.
// @format #,0.00
Analysis Years = DIVIDE ( [Analysis Days], 365.25 )


// Maintenance spend per year over the selected window.
// Expected: $9,320,016 all sites
// @format \$#,0.0,,"M"
Annual Maintenance Spend = DIVIDE ( [Total Maintenance Cost], [Analysis Years] )


// Corrective + emergency spend per year.
// Expected: $5,773,595 all sites
// @format \$#,0.0,,"M"
Annual Reactive Spend =
DIVIDE (
    CALCULATE ( [Total Maintenance Cost], FactWorkOrder[IsReactive] = 1 ),
    [Analysis Years]
)


// Everything that is not reactive: PM, inspection, safety, project work.
// Expected: $3,546,421 all sites
// @format \$#,0.0,,"M"
Annual Planned Spend = [Annual Maintenance Spend] - [Annual Reactive Spend]


// Sum of asset replacement cost for the selected sites. TREATAS for the same
// reason as Maintenance Cost % of RAV: DimAsset is not filtered by DimSite.
// Expected: $155,796,881 all sites
// @format \$#,0.0,,"M"
Replacement Asset Value =
VAR _Sites = VALUES ( DimSite[SITEID] )
RETURN
    CALCULATE (
        SUM ( DimAsset[REPLACECOST] ),
        DimAsset[ASSETNUM] <> "(none)",
        TREATAS ( _Sites, DimAsset[SITEID] )
    )


// The internal benchmark: Bedford's maintenance cost as a % of asset value.
// Bedford is the best-run site, so "spend at Bedford's rate" is a target the
// business has already proven it can hit - unlike the 2-3% SMRP best-in-class.
// Change the site code here to change the benchmark.
// Expected: 3.99%
// @format 0.00%
Benchmark Cost Rate =
CALCULATE ( [Maintenance Cost % of RAV], DimSite[SITEID] = "BEDFORD" )


// What each site would spend per year at the benchmark rate.
// Expected: Houston $2,832,197 / Aurora $1,432,504 / Bedford = its own spend
// @format \$#,0.0,,"M"
Spend at Benchmark Rate = [Replacement Asset Value] * [Benchmark Cost Rate]


// Annual spend above the benchmark, summed site by site. A site under the
// benchmark counts as zero - it does not offset another site's overspend.
// This is a gap to explain, not a saving anyone has booked.
// Rounded to whole dollars so the benchmark site itself is exactly 0, not a
// floating-point crumb that would show up as "Bedford $0.0M".
// Expected: $3,100,752 all sites - Houston $2,179,315, Aurora $921,437
// @format \$#,0.0,,"M"
Spend Above Benchmark =
SUMX (
    VALUES ( DimSite[SITEID] ),
    MAX ( 0, ROUND ( [Annual Maintenance Spend] - [Spend at Benchmark Rate], 0 ) )
)


// Reactive spend up to the benchmark line. With Annual Planned Spend and
// Spend Above Benchmark it stacks to the full annual spend in one bar.
// @format \$#,0.0,,"M"
Reactive Spend Within Benchmark =
MAX ( 0, [Annual Reactive Spend] - [Spend Above Benchmark] )


// Footer for the hero card, largest gap first.
// Expected: "Houston $2.2M · Aurora $0.9M · Bedford is the benchmark"
Spend Above Benchmark by Site =
VAR _Gaps =
    FILTER (
        ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@gap", [Spend Above Benchmark] ),
        [@gap] > 0
    )
RETURN
    CONCATENATEX (
        _Gaps,
        UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) ) & " " & FORMAT ( [@gap] / 1e6, "$#,0.0" ) & "M",
        " " & UNICHAR ( 183 ) & " ",
        [@gap], DESC
    )
        & " " & UNICHAR ( 183 ) & " Bedford is the benchmark"


// Footer for the annual spend card.
// Expected: "6.0% of asset value · best 2-3%"
Spend vs Asset Value Label =
FORMAT ( [Maintenance Cost % of RAV], "0.0%" ) & " of asset value " & UNICHAR ( 183 ) & " best 2-3%"


// Share of spend that went on corrective and emergency work.
// Expected: 62.0% all sites
// @format 0%
Reactive Cost Share = DIVIDE ( [Annual Reactive Spend], [Annual Maintenance Spend] )


// Mean cost of a FINISHED reactive job. Open jobs carry partial cost, so they
// are left out.
// Expected: $1,288 all sites
// @format \$#,0
Cost per Reactive Job =
CALCULATE (
    AVERAGE ( FactWorkOrder[ActualTotalCost] ),
    FactWorkOrder[IsCompleted] = 1,
    FactWorkOrder[IsReactive] = 1
)


// Mean cost of a finished PM.
// Expected: $234 all sites
// @format \$#,0
Cost per PM =
CALCULATE (
    AVERAGE ( FactWorkOrder[ActualTotalCost] ),
    FactWorkOrder[IsCompleted] = 1,
    FactWorkOrder[IsPM] = 1
)


// Expected: "5.5x the cost of a PM ($1,288 vs $234)"
Reactive vs PM Cost Label =
FORMAT ( DIVIDE ( [Cost per Reactive Job], [Cost per PM] ), "0.0" ) & "x the cost of a PM ("
    & FORMAT ( [Cost per Reactive Job], "$#,0" ) & " vs "
    & FORMAT ( [Cost per PM], "$#,0" ) & ")"


// STATUTORY WORK = inspection (INSP) + safety (SAF) work orders.
// Finished = completed with an actual finish date, the same rule as PM compliance.
// @format #,0
Statutory Completed =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsCompleted] = 1,
    NOT ISBLANK ( FactWorkOrder[ActFinishDate] ),
    FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" }
)


// Statutory jobs finished after their target date. Target is zero.
// Expected: 480 all sites - Houston 321, Aurora 103, Bedford 56
// @format #,0
Statutory Finished Late =
VAR _Done =
    CALCULATETABLE (
        FactWorkOrder,
        FactWorkOrder[IsCompleted] = 1,
        NOT ISBLANK ( FactWorkOrder[ActFinishDate] ),
        FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" }
    )
RETURN
    COUNTROWS (
        FILTER ( _Done, NOT ( FactWorkOrder[ActFinishDate] <= FactWorkOrder[TargCompDate] ) )
    ) + 0


// Expected: 79.5% all sites - Bedford 90.7%, Aurora 83.7%, Houston 70.8%
// @format 0.0%
Statutory On-Time % =
DIVIDE ( [Statutory Completed] - [Statutory Finished Late], [Statutory Completed] )


// Expected: "0 of 3 sites at 100%  ·  target 0"
Statutory Target Label =
VAR _Sites = VALUES ( DimSite[SITEID] )
VAR _AtTarget = COUNTROWS ( FILTER ( _Sites, [Statutory Finished Late] = 0 ) ) + 0
RETURN
    _AtTarget & " of " & COUNTROWS ( _Sites ) & " sites at 100% " & UNICHAR ( 183 ) & " target 0"


// Statutory on-time % for the quarter that ENDS in the month on the axis, by
// due date. Blank in other months, so a month axis plots one point per quarter.
// Quarters that started before the first full quarter of data are left out:
// work due then was partly raised before the extract began.
// Expected (Q2 2026): Bedford 92.0% / Aurora 89.3% / Houston 80.0%
// @format 0.0%
Statutory On-Time % (Quarter) =
VAR _MonthEnd = MAX ( DimDate[Date] )
VAR _QStart = EOMONTH ( _MonthEnd, -3 ) + 1
VAR _FirstFull =
    EDATE ( CALCULATE ( MIN ( FactWorkOrder[ReportDate] ), REMOVEFILTERS () ), 3 )
RETURN
    IF (
        MONTH ( _MonthEnd ) IN { 3, 6, 9, 12 }
            && _MonthEnd <= [Data As Of Date]
            && _QStart >= _FirstFull,
        CALCULATE (
            [Statutory On-Time %],
            DATESBETWEEN ( DimDate[Date], _QStart, _MonthEnd ),
            USERELATIONSHIP ( DimDate[Date], FactWorkOrder[TargCompDate] )
        )
    )


// REACTIVE WORK, YEAR ON YEAR
// Last 12 COMPLETE months before the data cut-off against the 12 before that.
// Fixed to the cut-off, so the year buttons do not move it.
// @format #,0
Reactive Work Orders =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsReactive] = 1,
    FactWorkOrder[IsCancelled] = 0
)


// Expected: 4,649 all sites (Jul 2025 - Jun 2026)
// @format #,0
Reactive WOs (Last 12M) =
VAR _End = EOMONTH ( [Data As Of Date], -1 )
VAR _Start = EOMONTH ( [Data As Of Date], -13 ) + 1
RETURN
    CALCULATE (
        [Reactive Work Orders],
        REMOVEFILTERS ( DimDate ),
        DATESBETWEEN ( DimDate[Date], _Start, _End )
    )


// Expected: 4,773 all sites (Jul 2024 - Jun 2025)
// @format #,0
Reactive WOs (Prior 12M) =
VAR _End = EOMONTH ( [Data As Of Date], -13 )
VAR _Start = EOMONTH ( [Data As Of Date], -25 ) + 1
RETURN
    CALCULATE (
        [Reactive Work Orders],
        REMOVEFILTERS ( DimDate ),
        DATESBETWEEN ( DimDate[Date], _Start, _End )
    )


// Negative is good: fewer reactive work orders than a year ago.
// Expected: Houston +4.7% / Aurora -21.4% / Bedford -2.3%
// @format +0%;-0%;0%
Reactive YoY % = DIVIDE ( [Reactive WOs (Last 12M)], [Reactive WOs (Prior 12M)] ) - 1


// Green when reactive work fell more than 5%, red when it rose, grey between.
Reactive YoY Colour =
VAR _v = [Reactive YoY %]
RETURN
    SWITCH ( TRUE (), ISBLANK ( _v ), BLANK (), _v < -0.05, "#4ADE80", _v > 0, "#F87171", "#A1A1AA" )


// Monthly reactive count, shown only for the last 12 complete months.
// @format #,0
Reactive WOs (This Year) =
VAR _End = EOMONTH ( [Data As Of Date], -1 )
VAR _Start = EOMONTH ( [Data As Of Date], -13 ) + 1
RETURN
    IF (
        MIN ( DimDate[Date] ) >= _Start && MAX ( DimDate[Date] ) <= _End,
        [Reactive Work Orders]
    )


// The same month one year earlier - the dashed comparison line.
// @format #,0
Reactive WOs (Same Month Last Year) =
VAR _End = EOMONTH ( [Data As Of Date], -1 )
VAR _Start = EOMONTH ( [Data As Of Date], -13 ) + 1
RETURN
    IF (
        MIN ( DimDate[Date] ) >= _Start && MAX ( DimDate[Date] ) <= _End,
        CALCULATE ( [Reactive Work Orders], DATEADD ( DimDate[Date], -1, YEAR ) )
    )


// Expected: "We spend $3.1M a year more than our own benchmark - 70% of it at Houston."
Overview Headline =
VAR _Gap = [Spend Above Benchmark]
VAR _Top =
    TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@gap", [Spend Above Benchmark] ), [@gap], DESC )
VAR _TopGap = MAXX ( _Top, [@gap] )
VAR _Id = MAXX ( _Top, DimSite[SITEID] )
VAR _TopSite = UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) )
RETURN
    IF (
        _Gap > 0,
        "We spend " & FORMAT ( _Gap / 1e6, "$#,0.0" ) & "M a year more than our own benchmark "
            & UNICHAR ( 8212 ) & " " & FORMAT ( DIVIDE ( _TopGap, _Gap ), "0%" ) & " of it at " & _TopSite & ".",
        "Spend is at or below our own benchmark."
    )


// PM & COMPLIANCE - CURRENT STATE (as of the data cut-off; ignores the year buttons)

// Open statutory jobs already past their target date.
// Expected: 40 all sites - Houston 23, Aurora 10, Bedford 7
// @format #,0
Statutory Overdue Today =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" },
    NOT ISBLANK ( FactWorkOrder[DaysOverdue] ),
    REMOVEFILTERS ( DimDate )
) + 0


// Expected: 7 all sites
// @format #,0
Statutory Overdue 1-7 Days =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" },
    FactWorkOrder[DaysOverdue] >= 1,
    FactWorkOrder[DaysOverdue] <= 7,
    REMOVEFILTERS ( DimDate )
)


// Expected: 19 all sites
// @format #,0
Statutory Overdue 8-30 Days =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" },
    FactWorkOrder[DaysOverdue] >= 8,
    FactWorkOrder[DaysOverdue] <= 30,
    REMOVEFILTERS ( DimDate )
)


// Expected: 14 all sites
// @format #,0
Statutory Overdue 31+ Days =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" },
    FactWorkOrder[DaysOverdue] >= 31,
    REMOVEFILTERS ( DimDate )
)


// Open statutory jobs falling due in the next 30 days. Work orders Maximo has
// generated ahead of the cut-off (report date in the future) are left out.
// Expected: 38 all sites - Houston 26
// @format #,0
Statutory Due Next 30 Days =
VAR _AsOf = [Data As Of Date]
RETURN
    CALCULATE (
        COUNTROWS ( FactWorkOrder ),
        FactWorkOrder[IsOpen] = 1,
        FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" },
        FactWorkOrder[TargCompDate] >= _AsOf,
        FactWorkOrder[TargCompDate] < _AsOf + 30,
        FactWorkOrder[ReportDate] <= _AsOf,
        REMOVEFILTERS ( DimDate )
    ) + 0


// Open PMs already past their target date.
// Expected: 610 all sites - Houston 352
// @format #,0
PMs Overdue Today =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[IsPM] = 1,
    NOT ISBLANK ( FactWorkOrder[DaysOverdue] ),
    REMOVEFILTERS ( DimDate )
) + 0


// Expected: "Houston 23 · Aurora 10 · Bedford 7"
Statutory Overdue by Site =
CONCATENATEX (
    ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@n", [Statutory Overdue Today] ),
    UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) ) & " " & [@n],
    " " & UNICHAR ( 183 ) & " ",
    [@n], DESC
)


// Expected: "most at Houston (26)"
Statutory Due Next 30 Days Label =
VAR _Top =
    TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@n", [Statutory Due Next 30 Days] ), [@n], DESC )
VAR _Id = MAXX ( _Top, DimSite[SITEID] )
RETURN
    "most at " & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & " (" & MAXX ( _Top, [@n] ) & ")"


// Expected: "most at Houston (352)"
PMs Overdue Label =
VAR _Top =
    TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@n", [PMs Overdue Today] ), [@n], DESC )
VAR _Id = MAXX ( _Top, DimSite[SITEID] )
RETURN
    "most at " & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & " (" & MAXX ( _Top, [@n] ) & ")"


// Expected: "480 finished late · target 100%"
Statutory Late Label =
FORMAT ( [Statutory Finished Late], "#,0" ) & " finished late " & UNICHAR ( 183 ) & " target 100%"


// Days past target for an open statutory job. Blank for every other work
// order, which is what limits the overdue table to the 40 rows that matter.
// Expected: oldest is WO 1035067, 81 days
// @format #,0
Statutory Days Overdue =
CALCULATE (
    MAX ( FactWorkOrder[DaysOverdue] ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" },
    REMOVEFILTERS ( DimDate )
)


// Plain-language status for the overdue table. Blank unless the row is an
// overdue statutory job, so it never adds rows to the table on its own.
Overdue Job Status =
IF (
    NOT ISBLANK ( [Statutory Days Overdue] ),
    SWITCH (
        SELECTEDVALUE ( FactWorkOrder[STATUS] ),
        "WAPPR", "awaiting approval",
        "APPR", "not started",
        "INPRG", "in progress"
    )
)


// Expected: "40 statutory jobs are overdue today - 23 at Houston. The oldest is 81 days late."
PM Compliance Headline =
VAR _N = [Statutory Overdue Today]
VAR _Top =
    TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@n", [Statutory Overdue Today] ), [@n], DESC )
VAR _Oldest =
    CALCULATE (
        MAX ( FactWorkOrder[DaysOverdue] ),
        FactWorkOrder[IsOpen] = 1,
        FactWorkOrder[WORKTYPE] IN { "INSP", "SAF" },
        REMOVEFILTERS ( DimDate )
    )
VAR _Id = MAXX ( _Top, DimSite[SITEID] )
RETURN
    IF (
        _N = 0,
        "No statutory jobs are overdue today.",
        _N & " statutory jobs are overdue today " & UNICHAR ( 8212 ) & " " & MAXX ( _Top, [@n] ) & " at "
            & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & ". The oldest is " & _Oldest & " days late."
    )


// WHICH PM SCHEDULES KEEP SLIPPING
// Per PM schedule (PMNUM), over the selected window. Schedules with fewer than
// 12 finished runs are blank - too few runs to call a pattern.
// Expected: 326 schedules qualify; 115 are under 80% on time;
// worst are PM-00305 and PM-00472 at 7 late of 12.
// @format 0.0%
PM Schedule On-Time % =
IF ( SUM ( FactWorkOrder[IsPMCompleted] ) >= 12, [PM Compliance %] )


// Expected for PM-00305: "7 of 12"
PM Schedule Late Runs =
VAR _Runs = SUM ( FactWorkOrder[IsPMCompleted] )
RETURN
    IF ( _Runs >= 12, ( _Runs - SUM ( FactWorkOrder[IsPMOnTime] ) ) & " of " & _Runs )


// Expected: 115
// @format #,0
PM Schedules Below 80% =
COUNTROWS (
    FILTER ( VALUES ( FactWorkOrder[PMNUM] ), [PM Schedule On-Time %] < 0.8 && NOT ISBLANK ( [PM Schedule On-Time %] ) )
)
