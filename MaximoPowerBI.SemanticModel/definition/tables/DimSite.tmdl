	column ORGID
		dataType: string
		lineageTag: 83fa0c04-c818-4b62-9347-22add2f4b125
		summarizeBy: none
		sourceColumn: ORGID

		annotation SummarizationSetBy = Automatic

	column OrgDescription
		dataType: string
		lineageTag: 6a79767e-d16e-4ead-9324-3d691ef01736
		summarizeBy: none
		sourceColumn: OrgDescription

