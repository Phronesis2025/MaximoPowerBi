// =============================================================================
// BACKLOG AND AGING MEASURES
// =============================================================================
//
// Requires the aging columns added to FactWorkOrder in Power Query
// (DaysOpen, DaysOverdue, AgeBucket, AgeBucketSort). Add these measures only
// after that change has been applied and refreshed.
//
// Every value below computed directly from the source CSVs.
//
// -----------------------------------------------------------------------------
// EXPECTED VALUES - no filters
// -----------------------------------------------------------------------------
//   Measure                        BEDFORD   HOUSTON    AURORA       ALL
//   Avg Age of Open Work (Days)       10.5      25.5      15.6      19.8
//   Backlog Hours Overdue            913.6   5,687.9   1,600.5   8,201.9
//   Overdue Emergency Work Orders        3        21         3        27
//   Aged Over 90 Days                   14        66        22       102
//
// Houston carries 69% of all overdue backlog hours and 65% of everything aged
// past 90 days, on 55% of the open work orders. Its backlog is not just larger,
// it is older.
// =============================================================================


// Mean age of open work, measured from the date it was raised. Distinct from
// Avg Days Overdue, which measures against the TARGET date - a work order can
// be 40 days old and not yet overdue if it was given a 60-day target.
// Expected: 19.8 days all sites
Avg Age of Open Work (Days) =
CALCULATE (
    AVERAGE ( FactWorkOrder[DaysOpen] ),
    FactWorkOrder[IsOpen] = 1,
    REMOVEFILTERS ( DimDate )
)


// Estimated labour hours sitting on work that is already late. This is the
// number a planner acts on - total backlog includes work that is still within
// its window and therefore not yet a problem.
// Expected: 8,201.9 hours all sites, of which Houston holds 5,687.9
Backlog Hours Overdue =
CALCULATE (
    SUM ( FactWorkOrder[ESTLABHRS] ),
    FactWorkOrder[IsOpen] = 1,
    NOT ISBLANK ( FactWorkOrder[DaysOverdue] ),
    REMOVEFILTERS ( DimDate )
)


// Emergency work that missed its target date. Emergency targets are same-day,
// so an overdue emergency is work that was classified as an emergency and then
// not treated as one. Small number, high signal.
// Expected: 27 all sites - Houston 21, Bedford 3, Aurora 3
Overdue Emergency Work Orders =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[WORKTYPE] = "EM",
    NOT ISBLANK ( FactWorkOrder[DaysOverdue] ),
    REMOVEFILTERS ( DimDate )
)


// Open work orders raised more than 90 days ago. The aging tail - work this old
// is rarely still relevant and usually needs cancelling or re-scoping rather
// than scheduling.
// Expected: 102 all sites - Houston 66
Aged Over 90 Days =
CALCULATE (
    COUNTROWS ( FactWorkOrder ),
    FactWorkOrder[IsOpen] = 1,
    FactWorkOrder[DaysOpen] > 90,
    REMOVEFILTERS ( DimDate )
)


// Share of backlog hours that are already late. More useful than a raw hour
// count when comparing sites of different sizes.
// Expected: Bedford 31.9%, Houston 58.4%, Aurora 49.9%, all sites 51.9%
Overdue Share of Backlog =
DIVIDE ( [Backlog Hours Overdue], [Backlog Hours] )


// -----------------------------------------------------------------------------
// STATUS COLOURS for the backlog cards
// -----------------------------------------------------------------------------

// No neutral published benchmark exists for backlog age, so these bands are
// stated as a working convention rather than a standard. Say so if asked.
Backlog Age Status Colour =
VAR _v = [Avg Age of Open Work (Days)]
RETURN
    SWITCH ( TRUE (), _v <= 14, "#107C41", _v <= 30, "#C77700", "#C00F0C" )


Overdue Status Colour =
VAR _v = [Overdue %]
RETURN
    SWITCH ( TRUE (), _v < 0.20, "#107C41", _v < 0.40, "#C77700", "#C00F0C" )
