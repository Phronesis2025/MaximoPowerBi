	/// Page list in the sidebar, Information highlighted. Transparent buttons on top do the navigating.
	measure 'HTML Nav Information' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 239 200' width='100%' style='display:block;max-height:100vh'>" &
			"<g transform='translate(11,10)' fill='none' stroke='#8B8B93' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/></g></g>" &
			"<text x='40' y='24' font-family='Segoe UI' font-size='15' fill='#B4B4BC'>Overview</text>" &
			"<g transform='translate(11,50)' fill='none' stroke='#8B8B93' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'><g transform='scale(0.75)'><path d='M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z'/><path d='M9 12l2 2 4-4'/></g></g>" &
