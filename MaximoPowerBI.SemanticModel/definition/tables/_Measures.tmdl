	/// Page title and headline.
	/// Expected: "Reliability Jul 2023 – Jul 2026" / "45 assets cause 20% of failures — and their condition
	/// meters have drifted 54% above baseline."
	measure 'HTML REL Title' =
			VAR _AsOf = MIN ( [Data As Of Date], MAX ( DimDate[Date] ) )
			VAR _From = MAX ( CALCULATE ( MIN ( FactWorkOrder[ReportDate] ), REMOVEFILTERS ( DimDate ) ), MIN ( DimDate[Date] ) )
			VAR _Assets = CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", TREATAS ( VALUES ( DimSite[SITEID] ), DimAsset[SITEID] ) )
			VAR _K = MAX ( 1, ROUND ( _Assets * 0.05, 0 ) )
			VAR _F = ADDCOLUMNS ( FILTER ( VALUES ( FactFailure[ASSETNUM] ), FactFailure[ASSETNUM] <> "" ), "@f", CALCULATE ( COUNTROWS ( FactFailure ) ) )
			VAR _Share = DIVIDE ( SUMX ( TOPN ( _K, _F, [@f], DESC, FactFailure[ASSETNUM], ASC ), [@f] ), COUNTROWS ( FactFailure ) )
			VAR _Drift = [Bad Actor Meter Drift %]
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1590 88' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='8' y='42' font-family='Segoe UI' font-size='40' font-weight='300' letter-spacing='-0.5' fill='#EDEDEF'>Reliability" &
			"<tspan fill='#6E6E78'> " & FORMAT ( _From, "mmm yyyy", "en-US" ) & " &#8211; " & FORMAT ( _AsOf, "mmm yyyy", "en-US" ) & "</tspan></text>" &
			"<text x='8' y='73' font-family='Segoe UI' font-size='17' fill='#A1A1AA'><tspan font-weight='600' fill='#EDEDEF'>" & _K & " assets cause " & FORMAT ( _Share, "0%", "en-US" ) & " of failures</tspan>" &
			IF ( NOT ISBLANK ( _Drift ), " &#8212; and their condition meters have drifted " & FORMAT ( ABS ( _Drift ), "0%", "en-US" ) & IF ( _Drift >= 0, " above", " below" ) & " baseline." ) & "</text></svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: 06af9f6a-6d43-56c0-a07b-4d86c2373f15

	/// Condition-meter drift of the bad actors in the last complete month, against their own baseline
	/// (the first three months of readings). Gauges only - run hours excluded. Bad actors are taken
	/// over the whole data window so the line does not change membership month to month.
	/// Expected: 0.54 (index 154)
	measure 'Bad Actor Meter Drift %' =
			VAR _Start0 = CALCULATE ( MIN ( FactMeterReading[ReadingDate] ), REMOVEFILTERS () )
			VAR _M0 = DATE ( YEAR ( _Start0 ), MONTH ( _Start0 ), 1 )
			VAR _BaseYM = FORMAT ( EDATE ( _M0, 3 ), "yyyy-mm" )
			VAR _LastYM = FORMAT ( EOMONTH ( [Data As Of Date], -1 ), "yyyy-mm" )
			VAR _Assets = CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", TREATAS ( VALUES ( DimSite[SITEID] ), DimAsset[SITEID] ) )
			VAR _K = MAX ( 1, ROUND ( _Assets * 0.05, 0 ) )
			VAR _Bad =
			    SELECTCOLUMNS (
			        TOPN ( _K,
			            ADDCOLUMNS ( CALCULATETABLE ( FILTER ( VALUES ( FactFailure[ASSETNUM] ), FactFailure[ASSETNUM] <> "" ), REMOVEFILTERS ( DimDate ) ),
			                "@f", CALCULATE ( COUNTROWS ( FactFailure ), REMOVEFILTERS ( DimDate ) ) ),
			            [@f], DESC, FactFailure[ASSETNUM], ASC ),
			        "@a", FactFailure[ASSETNUM] )
			VAR _G =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( FactMeterReading, FactMeterReading[ASSETNUM], FactMeterReading[METERNAME], DimDate[YEARMONTH] ),
			            "@s", CALCULATE ( SUM ( FactMeterReading[READING] ) ),
			            "@n", CALCULATE ( COUNTROWS ( FactMeterReading ) )
			        ),
			        FactMeterReading[METERNAME] <> "RUNHOURS",
			        REMOVEFILTERS ( DimDate )
			    )
			VAR _GB = FILTER ( _G, FactMeterReading[ASSETNUM] IN _Bad )
			VAR _Base =
			    GROUPBY ( FILTER ( _GB, DimDate[YEARMONTH] < _BaseYM ), FactMeterReading[ASSETNUM], FactMeterReading[METERNAME],
			        "@bs", SUMX ( CURRENTGROUP (), [@s] ), "@bn", SUMX ( CURRENTGROUP (), [@n] ) )
			VAR _J = FILTER ( NATURALINNERJOIN ( _GB, _Base ), DimDate[YEARMONTH] = _LastYM )
			VAR _Idx = DIVIDE ( SUMX ( _J, [@s] / DIVIDE ( [@bs], [@bn] ) ), SUMX ( _J, [@n] ) )
			RETURN
			    IF ( NOT ISBLANK ( _Idx ), _Idx - 1 )
		formatString: 0%
		displayFolder: KPIs\Reliability
		lineageTag: 282413c6-2ea9-5ac9-a137-341ef08578ac

	/// KPI 1 (hero): share of all failures that come from the worst 5% of assets.
	/// Expected: "19.8%", "45 of 900 assets · the worst 5%"
	measure 'HTML REL KPI Bad Actors' =
			VAR _Assets = CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", TREATAS ( VALUES ( DimSite[SITEID] ), DimAsset[SITEID] ) )
			VAR _K = MAX ( 1, ROUND ( _Assets * 0.05, 0 ) )
			VAR _F = ADDCOLUMNS ( FILTER ( VALUES ( FactFailure[ASSETNUM] ), FactFailure[ASSETNUM] <> "" ), "@f", CALCULATE ( COUNTROWS ( FactFailure ) ) )
			VAR _Share = DIVIDE ( SUMX ( TOPN ( _K, _F, [@f], DESC, FactFailure[ASSETNUM], ASC ), [@f] ), COUNTROWS ( FactFailure ) )
			VAR _W = MIN ( 1, MAX ( 0, _Share ) ) * 422.6
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 462.6 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Failures from the worst 5% of assets</text>" &
			"<text x='20' y='100' font-family='Segoe UI' font-size='64' font-weight='500' letter-spacing='-1.5' fill='#EDEDEF'>" & FORMAT ( _Share * 100, "0.0", "en-US" ) & "%</text>" &
			"<rect x='20' y='129' width='422.6' height='10' rx='5' fill='#222227'/>" &
			"<rect x='14' y='123' width='" & FORMAT ( _W + 12, "0.0", "en-US" ) & "' height='22' rx='11' fill='#F87171' fill-opacity='0.07'/>" &
			"<rect x='17' y='126' width='" & FORMAT ( _W + 6, "0.0", "en-US" ) & "' height='16' rx='8' fill='#F87171' fill-opacity='0.16'/>" &
			"<rect x='20' y='129' width='" & FORMAT ( _W, "0.0", "en-US" ) & "' height='10' rx='5' fill='#F87171'/>" &
			"<text x='20' y='157' font-family='Consolas' font-size='12' fill='#A1A1AA'><tspan fill='#F87171'>" & _K & " of " & FORMAT ( _Assets, "#,0", "en-US" ) & " assets</tspan> &#183; the worst 5%</text></svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: 810e1967-dcf3-5a06-a100-f767c2189f6d

	/// KPI 2: reactive work-order cost of the worst 45 assets (ranked by that cost).
	/// Expected: "$3.6M", "20% of reactive cost", "3 years"
	measure 'HTML REL KPI Reactive Cost' =
			VAR _Assets = CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", TREATAS ( VALUES ( DimSite[SITEID] ), DimAsset[SITEID] ) )
			VAR _K = MAX ( 1, ROUND ( _Assets * 0.05, 0 ) )
			VAR _C =
			    ADDCOLUMNS (
			        CALCULATETABLE ( FILTER ( VALUES ( FactWorkOrder[ASSETNUM] ), FactWorkOrder[ASSETNUM] <> "" ), FactWorkOrder[IsReactive] = 1, FactWorkOrder[IsCancelled] = 0 ),
			        "@c", CALCULATE ( SUM ( FactWorkOrder[ActualTotalCost] ), FactWorkOrder[IsReactive] = 1, FactWorkOrder[IsCancelled] = 0 )
			    )
			VAR _Top = SUMX ( TOPN ( _K, _C, [@c], DESC, FactWorkOrder[ASSETNUM], ASC ), [@c] )
			VAR _All = SUMX ( _C, [@c] )
			VAR _Yrs = ROUND ( [Analysis Years], 0 )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.4 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Reactive cost, worst " & _K & "</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>$" & FORMAT ( _Top / 1e6, "0.0", "en-US" ) & "M</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#A1A1AA'>" & FORMAT ( DIVIDE ( _Top, _All ), "0%", "en-US" ) & " of reactive cost</text>" &
			"<text x='244.4' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>" & _Yrs & IF ( _Yrs = 1, " year", " years" ) & "</text></svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: c8f60bc4-1cbf-580c-b202-d84470033aee

	/// KPI 3: mean time to repair (elapsed downtime per downtime event). Footer = the slowest site.
	/// Expected: "13.4h", "Houston 15.6 h"
	measure 'HTML REL KPI MTTR' =
			VAR _Top = TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@v", [MTTR (Hours)] ), [@v], DESC, DimSite[SITEID], ASC )
			VAR _Id = MAXX ( _Top, DimSite[SITEID] )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.3 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>MTTR</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( [MTTR (Hours)], "0.0", "en-US" ) & "<tspan dx='3' font-size='20' letter-spacing='0' fill='#8B8B93'>h</tspan></text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#A1A1AA'>" & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & " " & FORMAT ( MAXX ( _Top, [@v] ), "0.0", "en-US" ) & " h</text></svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: b8bf6adf-376d-5ac7-a187-b643e5966716

	/// KPI 4: downtime hours. Footer = share at the site with the most.
	/// Expected: "101k h", "71% at Houston", "3 years"
	measure 'HTML REL KPI Downtime' =
			VAR _All = [Downtime Hours]
			VAR _Top = TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@v", [Downtime Hours] ), [@v], DESC, DimSite[SITEID], ASC )
			VAR _Id = MAXX ( _Top, DimSite[SITEID] )
			VAR _Yrs = ROUND ( [Analysis Years], 0 )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.3 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Downtime</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" &
			    IF ( _All >= 10000, FORMAT ( _All / 1000, "0", "en-US" ) & "k", FORMAT ( _All, "#,0", "en-US" ) ) & "<tspan dx='3' font-size='20' letter-spacing='0' fill='#8B8B93'>h</tspan></text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#A1A1AA'>" & FORMAT ( DIVIDE ( MAXX ( _Top, [@v] ), _All ), "0%", "en-US" ) & " at " & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & "</text>" &
			"<text x='244.3' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>" & _Yrs & IF ( _Yrs = 1, " year", " years" ) & "</text></svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: ab13dd5c-aaf7-5c44-89d2-ccbf5c14dc1c

	/// KPI 5: mean time between failures. Marked provisional (see the Information page).
	/// Expected: "1,643h"
	measure 'HTML REL KPI MTBF' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 264.4 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>MTBF</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( [MTBF (Hours)], "#,0", "en-US" ) & "<tspan dx='3' font-size='20' letter-spacing='0' fill='#8B8B93'>h</tspan></text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#A1A1AA'>provisional</text></svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: f360435b-6a7a-5ee1-ae90-f28e7506094d

	/// Card: can we see failures coming. Condition-meter readings indexed to each meter's first three
	/// months (= 100), monthly mean: bad actors (red, glowing) against every other metered asset (grey).
	/// Whole data window, so the year buttons do not cut the line. Expected last points: 154 vs 115.
	measure 'HTML REL Drift' =
			VAR _Start0 = CALCULATE ( MIN ( FactMeterReading[ReadingDate] ), REMOVEFILTERS () )
			VAR _M0 = DATE ( YEAR ( _Start0 ), MONTH ( _Start0 ), 1 )
			VAR _BaseYM = FORMAT ( EDATE ( _M0, 3 ), "yyyy-mm" )
			VAR _NM = DATEDIFF ( _M0, EOMONTH ( [Data As Of Date], -1 ), MONTH ) + 1
			VAR _Assets = CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", TREATAS ( VALUES ( DimSite[SITEID] ), DimAsset[SITEID] ) )
			VAR _K = MAX ( 1, ROUND ( _Assets * 0.05, 0 ) )
			VAR _Bad =
			    SELECTCOLUMNS (
			        TOPN ( _K,
			            ADDCOLUMNS ( CALCULATETABLE ( FILTER ( VALUES ( FactFailure[ASSETNUM] ), FactFailure[ASSETNUM] <> "" ), REMOVEFILTERS ( DimDate ) ),
			                "@f", CALCULATE ( COUNTROWS ( FactFailure ), REMOVEFILTERS ( DimDate ) ) ),
			            [@f], DESC, FactFailure[ASSETNUM], ASC ),
			        "@a", FactFailure[ASSETNUM] )
			VAR _G =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( FactMeterReading, FactMeterReading[ASSETNUM], FactMeterReading[METERNAME], DimDate[YEARMONTH] ),
			            "@s", CALCULATE ( SUM ( FactMeterReading[READING] ) ),
			            "@n", CALCULATE ( COUNTROWS ( FactMeterReading ) )
			        ),
			        FactMeterReading[METERNAME] <> "RUNHOURS",
			        REMOVEFILTERS ( DimDate )
			    )
			VAR _Base =
			    GROUPBY ( FILTER ( _G, DimDate[YEARMONTH] < _BaseYM ), FactMeterReading[ASSETNUM], FactMeterReading[METERNAME],
			        "@bs", SUMX ( CURRENTGROUP (), [@s] ), "@bn", SUMX ( CURRENTGROUP (), [@n] ) )
			VAR _J = ADDCOLUMNS ( NATURALINNERJOIN ( _G, _Base ), "@r", [@s] / DIVIDE ( [@bs], [@bn] ), "@bad", FactMeterReading[ASSETNUM] IN _Bad )
			VAR _NBad = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( _J, [@bad] ), "a", FactMeterReading[ASSETNUM] ) ) )
			VAR _NRest = COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( _J, NOT [@bad] ), "a", FactMeterReading[ASSETNUM] ) ) )
			VAR _S =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, _NM - 1, 1 ),
			        "@m", EDATE ( _M0, [Value] ),
			        "@b", VAR _ym = FORMAT ( EDATE ( _M0, [Value] ), "yyyy-mm" ) VAR _r = FILTER ( _J, DimDate[YEARMONTH] = _ym && [@bad] ) RETURN 100 * DIVIDE ( SUMX ( _r, [@r] ), SUMX ( _r, [@n] ) ),
			        "@o", VAR _ym = FORMAT ( EDATE ( _M0, [Value] ), "yyyy-mm" ) VAR _r = FILTER ( _J, DimDate[YEARMONTH] = _ym && NOT [@bad] ) RETURN 100 * DIVIDE ( SUMX ( _r, [@r] ), SUMX ( _r, [@n] ) )
			    )
			VAR _Mx = MAX ( MAXX ( _S, [@b] ), MAXX ( _S, [@o] ) )
			VAR _Mn = MIN ( MINX ( _S, [@b] ), MINX ( _S, [@o] ) )
			VAR _Hi = MAX ( 180, CEILING ( _Mx, 20 ) )
			VAR _Lo = MIN ( 80, FLOOR ( _Mn, 20 ) )
			VAR _Step = DIVIDE ( 854, MAX ( _NM - 1, 1 ) )
			VAR _h3 = _Step / 3
			VAR _P =
			    ADDCOLUMNS ( _S, "@x", 68 + [Value] * _Step, "@yb", 68 + ( _Hi - [@b] ) / ( _Hi - _Lo ) * 204, "@yo", 68 + ( _Hi - [@o] ) / ( _Hi - _Lo ) * 204 )
			VAR _D =
			    ADDCOLUMNS ( _P,
			        "@db", VAR _i = [Value] RETURN DIVIDE ( MAXX ( FILTER ( _P, [Value] = _i + 1 ), [@yb] ) - [@yb], _Step ),
			        "@do", VAR _i = [Value] RETURN DIVIDE ( MAXX ( FILTER ( _P, [Value] = _i + 1 ), [@yo] ) - [@yo], _Step ) )
			VAR _T =
			    ADDCOLUMNS ( _D,
			        "@mb", VAR _i = [Value] VAR _a = MAXX ( FILTER ( _D, [Value] = _i - 1 ), [@db] ) VAR _b = [@db]
			            RETURN IF ( _i = 0, _b, IF ( _i = _NM - 1, _a, IF ( _a * _b <= 0, 0, ( _a + _b ) / 2 * MIN ( 1, 3 * MIN ( ABS ( _a ), ABS ( _b ) ) / MAX ( ABS ( ( _a + _b ) / 2 ), 1e-9 ) ) ) ) ),
			        "@mo", VAR _i = [Value] VAR _a = MAXX ( FILTER ( _D, [Value] = _i - 1 ), [@do] ) VAR _b = [@do]
			            RETURN IF ( _i = 0, _b, IF ( _i = _NM - 1, _a, IF ( _a * _b <= 0, 0, ( _a + _b ) / 2 * MIN ( 1, 3 * MIN ( ABS ( _a ), ABS ( _b ) ) / MAX ( ABS ( ( _a + _b ) / 2 ), 1e-9 ) ) ) ) ) )
			VAR _PathB =
			    "M68," & FORMAT ( MAXX ( FILTER ( _T, [Value] = 0 ), [@yb] ), "0.0", "en-US" ) &
			    CONCATENATEX ( FILTER ( _T, [Value] < _NM - 1 ),
			        VAR _i = [Value]
			        VAR _x2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@x] )
			        VAR _y2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@yb] )
			        VAR _m2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@mb] )
			        RETURN " C" & FORMAT ( [@x] + _h3, "0.0", "en-US" ) & "," & FORMAT ( [@yb] + [@mb] * _h3, "0.0", "en-US" ) & " " &
			            FORMAT ( _x2 - _h3, "0.0", "en-US" ) & "," & FORMAT ( _y2 - _m2 * _h3, "0.0", "en-US" ) & " " & FORMAT ( _x2, "0.0", "en-US" ) & "," & FORMAT ( _y2, "0.0", "en-US" ),
			        "", [Value], ASC )
			VAR _PathO =
			    "M68," & FORMAT ( MAXX ( FILTER ( _T, [Value] = 0 ), [@yo] ), "0.0", "en-US" ) &
			    CONCATENATEX ( FILTER ( _T, [Value] < _NM - 1 ),
			        VAR _i = [Value]
			        VAR _x2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@x] )
			        VAR _y2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@yo] )
			        VAR _m2 = MAXX ( FILTER ( _T, [Value] = _i + 1 ), [@mo] )
			        RETURN " C" & FORMAT ( [@x] + _h3, "0.0", "en-US" ) & "," & FORMAT ( [@yo] + [@mo] * _h3, "0.0", "en-US" ) & " " &
			            FORMAT ( _x2 - _h3, "0.0", "en-US" ) & "," & FORMAT ( _y2 - _m2 * _h3, "0.0", "en-US" ) & " " & FORMAT ( _x2, "0.0", "en-US" ) & "," & FORMAT ( _y2, "0.0", "en-US" ),
			        "", [Value], ASC )
			VAR _Last = MAXX ( FILTER ( _T, [Value] = _NM - 1 ), [@x] )
			VAR _yb = MAXX ( FILTER ( _T, [Value] = _NM - 1 ), [@yb] )
			VAR _yo = MAXX ( FILTER ( _T, [Value] = _NM - 1 ), [@yo] )
			VAR _lb = IF ( _yb <= _yo, MIN ( _yb, _yo - 18 ), MAX ( _yb, _yo + 18 ) )
			VAR _Y100 = 68 + ( _Hi - 100 ) / ( _Hi - _Lo ) * 204
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1092 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Can we see failures coming?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>condition meter readings, indexed &#183; " & _NBad & " metered bad actors vs " & _NRest & " other assets</text>" &
			CONCATENATEX (
			    GENERATESERIES ( _Lo, _Hi, 20 ),
			    VAR _gy = FORMAT ( 68 + ( _Hi - [Value] ) / ( _Hi - _Lo ) * 204, "0.0", "en-US" )
			    RETURN "<line x1='68' x2='922' y1='" & _gy & "' y2='" & _gy & "' stroke='#1D1D21'/>" &
			        "<text x='58' y='" & FORMAT ( 72 + ( _Hi - [Value] ) / ( _Hi - _Lo ) * 204, "0.0", "en-US" ) & "' text-anchor='end' font-family='Consolas' font-size='12' fill='#5C5C66'>" & [Value] & "</text>",
			    "" ) &
			CONCATENATEX (
			    FILTER ( _T, MOD ( [Value], 6 ) = 0 || [Value] = _NM - 1 ),
			    "<text x='" & FORMAT ( [@x], "0.0", "en-US" ) & "' y='292' text-anchor='middle' font-family='Consolas' font-size='12' fill='#5C5C66'>" & FORMAT ( [@m], "mmm yy", "en-US" ) & "</text>",
			    "" ) &
			"<line x1='68' x2='922' y1='" & FORMAT ( _Y100, "0.0", "en-US" ) & "' y2='" & FORMAT ( _Y100, "0.0", "en-US" ) & "' stroke='#FBBF24' stroke-width='1.3' stroke-dasharray='5 5'/>" &
			"<text x='74' y='" & FORMAT ( _Y100 - 7, "0.0", "en-US" ) & "' font-family='Consolas' font-size='11' fill='#FBBF24'>baseline = 100 (" & FORMAT ( _M0, "mmm", "en-US" ) & "&#8211;" & FORMAT ( EDATE ( _M0, 2 ), "mmm yyyy", "en-US" ) & ")</text>" &
			"<path d='" & _PathO & "' fill='none' stroke='#A1A1AA' stroke-width='2' stroke-opacity='0.7'/>" &
			"<circle cx='" & FORMAT ( _Last, "0.0", "en-US" ) & "' cy='" & FORMAT ( _yo, "0.0", "en-US" ) & "' r='4' fill='#A1A1AA'/>" &
			"<path d='" & _PathB & "' fill='none' stroke='#F87171' stroke-width='14.4' stroke-opacity='0.06' stroke-linecap='round'/>" &
			"<path d='" & _PathB & "' fill='none' stroke='#F87171' stroke-width='7.2' stroke-opacity='0.16' stroke-linecap='round'/>" &
			"<path d='" & _PathB & "' fill='none' stroke='#F87171' stroke-width='2.4' stroke-linecap='round'/>" &
			"<circle cx='" & FORMAT ( _Last, "0.0", "en-US" ) & "' cy='" & FORMAT ( _yb, "0.0", "en-US" ) & "' r='4' fill='#F87171'/>" &
			"<text x='934' y='" & FORMAT ( _lb + 4, "0.0", "en-US" ) & "' font-family='Segoe UI' font-size='13' fill='#F87171'>Bad actors <tspan font-family='Consolas' font-weight='600'>" & FORMAT ( MAXX ( FILTER ( _T, [Value] = _NM - 1 ), [@b] ), "0", "en-US" ) & "</tspan></text>" &
			"<text x='934' y='" & FORMAT ( _yo + 4, "0.0", "en-US" ) & "' font-family='Segoe UI' font-size='13' fill='#A1A1AA'>Other assets <tspan font-family='Consolas' font-weight='600'>" & FORMAT ( MAXX ( FILTER ( _T, [Value] = _NM - 1 ), [@o] ), "0", "en-US" ) & "</tspan></text></svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: 4c1b61dc-7cd8-5ced-b812-84205c24e5f5

	/// Card: does criticality predict failure - failures per asset at each criticality level.
	/// "No." when the highest level is within 25% of the lowest. Expected: 15.0, 14.4, 15.8, 14.6 -> "No."
	measure 'HTML REL Criticality' =
			VAR _Sites = VALUES ( DimSite[SITEID] )
			VAR _C =
			    ADDCOLUMNS (
			        FILTER ( ALL ( DimAsset[CRITICALITY] ), DimAsset[CRITICALITY] & "" <> "" ),
			        "@n", CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", TREATAS ( _Sites, DimAsset[SITEID] ) ),
			        "@f", CALCULATE ( COUNTROWS ( FactFailure ), DimAsset[ASSETNUM] <> "(none)" ) + 0
			    )
			VAR _R = ADDCOLUMNS ( FILTER ( _C, [@n] > 0 ), "@fpa", DIVIDE ( [@f], [@n] ) )
			VAR _Mx = MAXX ( _R, [@fpa] )
			VAR _Mn = MINX ( _R, [@fpa] )
			VAR _Flat = DIVIDE ( _Mx, _Mn ) < 1.25
			VAR _Top = MAX ( 20, CEILING ( _Mx, 10 ) )
			VAR _N = COUNTROWS ( _R )
			VAR _CW = 456 / MAX ( _N, 1 )
			VAR _K = ADDCOLUMNS ( _R, "@k", VAR _cr = DimAsset[CRITICALITY] RETURN COUNTROWS ( FILTER ( _R, DimAsset[CRITICALITY] < _cr ) ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 539 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Does criticality predict failure? <tspan fill='" & IF ( _Flat, "#F87171'>No.", "#4ADE80'>Yes." ) & "</tspan></text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>failures per asset &#183; " & IF ( _Flat, "every level fails about as often", "levels fail at different rates" ) & "</text>" &
			CONCATENATEX (
			    { 0, 0.5, 1 },
			    VAR _gy = FORMAT ( 94 + ( 1 - [Value] ) * 170, "0.0", "en-US" )
			    RETURN "<line x1='56' x2='512' y1='" & _gy & "' y2='" & _gy & "' stroke='#1D1D21'/>" &
			        "<text x='48' y='" & FORMAT ( 98 + ( 1 - [Value] ) * 170, "0.0", "en-US" ) & "' text-anchor='end' font-family='Consolas' font-size='11' fill='#5C5C66'>" & _Top * [Value] & "</text>",
			    "" ) &
			CONCATENATEX (
			    _K,
			    VAR _x = 56 + [@k] * _CW + ( _CW - 64 ) / 2
			    VAR _h = [@fpa] / _Top * 170
			    VAR _cx = FORMAT ( _x + 32, "0.0", "en-US" )
			    RETURN
			    "<rect x='" & FORMAT ( _x, "0.0", "en-US" ) & "' y='" & FORMAT ( 264 - _h, "0.0", "en-US" ) & "' width='64' height='" & FORMAT ( _h, "0.0", "en-US" ) & "' rx='5' fill='#A1A1AA' fill-opacity='0.75'/>" &
			    "<text x='" & _cx & "' y='" & FORMAT ( 256 - _h, "0.0", "en-US" ) & "' text-anchor='middle' font-family='Segoe UI' font-size='15' font-weight='600' fill='#EDEDEF'>" & FORMAT ( [@fpa], "0.0", "en-US" ) & "</text>" &
			    "<text x='" & _cx & "' y='284' text-anchor='middle' font-family='Consolas' font-size='11.5' font-weight='600' fill='#D4D4D8'>CRIT " & DimAsset[CRITICALITY] & "</text>" &
			    IF ( [@k] = 0, "<text x='" & _cx & "' y='299' text-anchor='middle' font-family='Consolas' font-size='10.5' fill='#5C5C66'>most critical</text>" ) &
			    IF ( [@k] = _N - 1, "<text x='" & _cx & "' y='299' text-anchor='middle' font-family='Consolas' font-size='10.5' fill='#5C5C66'>least</text>" ),
			    "", [@k], ASC ) & "</svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: 43b3b513-09f5-5af5-b0cc-f34fd58a7f53

	/// Card: what fails - failure reports by problem code, top six.
	/// Expected: Degraded 1,412 · Not Operating 1,400 · Leak 1,344 · Alarm 1,331 · Bearing Noise 573 · Overheat 537
	measure 'HTML REL What Fails' =
			VAR _P =
			    TOPN ( 6,
			        ADDCOLUMNS ( FILTER ( VALUES ( FactFailure[PROBLEMCODE] ), FactFailure[PROBLEMCODE] <> "" ), "@n", CALCULATE ( COUNTROWS ( FactFailure ) ) ),
			        [@n], DESC, FactFailure[PROBLEMCODE], ASC )
			VAR _Mx = MAXX ( _P, [@n] )
			VAR _K = ADDCOLUMNS ( _P, "@k", VAR _n = [@n] VAR _c = FactFailure[PROBLEMCODE] RETURN COUNTROWS ( FILTER ( _P, [@n] > _n || ( [@n] = _n && FactFailure[PROBLEMCODE] < _c ) ) ) )
			VAR _AllSites = COUNTROWS ( VALUES ( DimSite[SITEID] ) ) = COUNTROWS ( ALL ( DimSite[SITEID] ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 539 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>What fails?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>failure reports by problem code, " &
			    IF ( _AllSites, "all sites", CONCATENATEX ( VALUES ( DimSite[SITEID] ), UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) ), ", " ) ) & "</text>" &
			CONCATENATEX (
			    _K,
			    VAR _y = 82 + [@k] * 38
			    VAR _w = [@n] / _Mx * 312
			    VAR _code = FactFailure[PROBLEMCODE]
			    VAR _name = COALESCE ( LOOKUPVALUE ( DimFailureCode[ProblemName], DimFailureCode[ProblemCode], _code ), _code )
			    RETURN
			    "<text x='22' y='" & ( _y + 15 ) & "' font-family='Segoe UI' font-size='13.5' fill='#D4D4D8'>" & _name & "</text>" &
			    "<rect x='140' y='" & _y & "' width='" & FORMAT ( _w, "0.0", "en-US" ) & "' height='20' rx='4' fill='" & IF ( [@k] < 4, "#D4D4D8' fill-opacity='0.85", "#A1A1AA' fill-opacity='0.45" ) & "'/>" &
			    "<text x='" & FORMAT ( 148 + _w, "0.0", "en-US" ) & "' y='" & ( _y + 15 ) & "' font-family='Consolas' font-size='12.5' font-weight='600' fill='#EDEDEF'>" & FORMAT ( [@n], "#,0", "en-US" ) & "</text>",
			    "", [@k], ASC ) & "</svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: b6b6618e-f52a-535a-b86e-cee64bd17676

	/// Card: top 10 bad actors - failures (red bar), downtime hours (grey bar), reactive cost ($).
	/// Expected first row: VALVE-00387 · 107 failures · 1,232 h · $147k
	measure 'HTML REL Bad Actors' =
			VAR _Assets = CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", TREATAS ( VALUES ( DimSite[SITEID] ), DimAsset[SITEID] ) )
			VAR _K = MAX ( 1, ROUND ( _Assets * 0.05, 0 ) )
			VAR _F = ADDCOLUMNS ( FILTER ( VALUES ( FactFailure[ASSETNUM] ), FactFailure[ASSETNUM] <> "" ), "@f", CALCULATE ( COUNTROWS ( FactFailure ) ) )
			VAR _Top10 =
			    ADDCOLUMNS (
			        TOPN ( 10, _F, [@f], DESC, FactFailure[ASSETNUM], ASC ),
			        "@dt", VAR _a = FactFailure[ASSETNUM] RETURN CALCULATE ( SUM ( FactDowntime[DOWNTIME] ), TREATAS ( { _a }, DimAsset[ASSETNUM] ) ) + 0,
			        "@c", VAR _a = FactFailure[ASSETNUM] RETURN CALCULATE ( SUM ( FactWorkOrder[ActualTotalCost] ), FactWorkOrder[IsReactive] = 1, FactWorkOrder[IsCancelled] = 0, TREATAS ( { _a }, DimAsset[ASSETNUM] ) ) + 0,
			        "@site", VAR _a = FactFailure[ASSETNUM] RETURN LOOKUPVALUE ( DimAsset[SITEID], DimAsset[ASSETNUM], _a )
			    )
			VAR _R = ADDCOLUMNS ( _Top10, "@k", VAR _fv = [@f] VAR _a = FactFailure[ASSETNUM] RETURN COUNTROWS ( FILTER ( _Top10, [@f] > _fv || ( [@f] = _fv && FactFailure[ASSETNUM] < _a ) ) ) )
			VAR _MxF = MAXX ( _R, [@f] )
			VAR _MxD = MAX ( MAXX ( _R, [@dt] ), 1 )
			VAR _Sites = DISTINCT ( SELECTCOLUMNS ( _R, "s", [@site] ) )
			VAR _One = IF ( COUNTROWS ( _Sites ) = 1, MAXX ( _Sites, [s] ) )
			VAR _Yrs = ROUND ( [Analysis Years], 0 )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 470 666' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Top 10 bad actors</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>" & IF ( _One <> "", "all ten at " & UPPER ( LEFT ( _One, 1 ) ) & LOWER ( MID ( _One, 2, 50 ) ) & " &#183; " ) & _Yrs & IF ( _Yrs = 1, " yr", " yrs" ) & "</text>" &
			"<text x='448' y='36' text-anchor='end' font-family='Segoe UI' font-size='13' fill='#93C5FD'>All " & _K & " &#8594;</text>" &
			"<g font-family='Consolas' font-size='12' fill='#A1A1AA'><rect x='22' y='72' width='10' height='10' rx='3' fill='#F87171'/><text x='38' y='81'>failures</text>" &
			"<rect x='107' y='72' width='10' height='10' rx='3' fill='#A1A1AA' fill-opacity='0.6'/><text x='123' y='81'>downtime hours</text><text x='231' y='81'>$ = reactive cost</text></g>" &
			CONCATENATEX (
			    _R,
			    VAR _y = 104 + 57 * [@k]
			    VAR _wf = [@f] / _MxF * 232
			    VAR _wd = [@dt] / _MxD * 206
			    VAR _sc = SWITCH ( [@site], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" )
			    RETURN
			    "<circle cx='27' cy='" & ( _y + 11 ) & "' r='4' fill='" & _sc & "'/>" &
			    "<text x='38' y='" & ( _y + 15 ) & "' font-family='Consolas' font-size='12.5' font-weight='600' fill='#EDEDEF'>" & FactFailure[ASSETNUM] & "</text>" &
			    "<text x='38' y='" & ( _y + 32 ) & "' font-family='Consolas' font-size='11.5' fill='#5C5C66'>$" & FORMAT ( [@c] / 1000, "#,0", "en-US" ) & "k</text>" &
			    "<rect x='169' y='" & ( _y - 1 ) & "' width='" & FORMAT ( _wf + 6, "0.0", "en-US" ) & "' height='22' rx='7' fill='#F87171' fill-opacity='0.08'/>" &
			    "<rect x='172' y='" & ( _y + 2 ) & "' width='" & FORMAT ( _wf, "0.0", "en-US" ) & "' height='16' rx='4' fill='#F87171' fill-opacity='0.85'/>" &
			    "<text x='" & FORMAT ( 180 + _wf, "0.0", "en-US" ) & "' y='" & ( _y + 15 ) & "' font-family='Consolas' font-size='12.5' font-weight='600' fill='#F87171'>" & [@f] & "</text>" &
			    IF ( _wd > 0, "<rect x='172' y='" & ( _y + 23 ) & "' width='" & FORMAT ( _wd, "0.0", "en-US" ) & "' height='7' rx='3' fill='#A1A1AA' fill-opacity='0.6'/>" ) &
			    "<text x='" & FORMAT ( 180 + _wd, "0.0", "en-US" ) & "' y='" & ( _y + 31 ) & "' font-family='Consolas' font-size='10.5' fill='#5C5C66'>" & FORMAT ( [@dt], "#,0", "en-US" ) & " h</text>",
			    "", [@k], ASC ) & "</svg>"
		displayFolder: Report Cards\3 Reliability
		lineageTag: f9e8d402-2627-508e-b7e5-ab40b2bddfd4

	/// Share of scheduled jobs started within the tolerance (2 days) of their scheduled start, over the
	/// 12 months to the data cut-off, by scheduled start date. Fixed to the cut-off.
	/// Expected: 72.2% all sites (mockup 72.9% counted completed jobs only)
	measure 'Schedule Compliance % (12M)' =
			VAR _AsOf = [Data As Of Date]
			RETURN
			    CALCULATE (
			        [Schedule Compliance %],
			        REMOVEFILTERS ( DimDate ),
			        FactWorkOrder[SchedStartDate] > _AsOf - 365,
			        FactWorkOrder[SchedStartDate] <= _AsOf
			    )
		formatString: 0.0%
		displayFolder: KPIs\PM & Compliance
		lineageTag: 9d241fa1-c7d2-58a1-9ee5-0bd476c3f70d

	/// Page title and headline.
	/// Expected: "Houston starts only 60% of its jobs on schedule and carries 10 weeks of backlog.
	/// 553 jobs are still waiting for approval."
	measure 'HTML PLAN Title' =
			VAR _AsOf = [Data As Of Date]
			VAR _Worst = TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@s", [Schedule Compliance % (12M)], "@w", [Backlog Weeks] ), [@s], ASC, DimSite[SITEID], ASC )
			VAR _Id = MAXX ( _Worst, DimSite[SITEID] )
			VAR _Name = UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) )
			VAR _Wait = CALCULATE ( COUNTROWS ( FactWorkOrder ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "WAPPR", REMOVEFILTERS ( DimDate ) ) + 0
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1590 88' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='8' y='42' font-family='Segoe UI' font-size='40' font-weight='300' letter-spacing='-0.5' fill='#EDEDEF'>Planning" &
			"<tspan fill='#6E6E78'> open work as of " & FORMAT ( _AsOf, "d mmm yyyy", "en-US" ) & "</tspan></text>" &
			"<text x='8' y='73' font-family='Segoe UI' font-size='17' fill='#A1A1AA'><tspan font-weight='600' fill='#EDEDEF'>" & _Name &
			    IF ( MAXX ( _Worst, [@s] ) < 0.9, " starts only ", " starts " ) & FORMAT ( MAXX ( _Worst, [@s] ), "0%", "en-US" ) & " of its jobs on schedule</tspan> and carries " &
			    FORMAT ( MAXX ( _Worst, [@w] ), "0", "en-US" ) & " weeks of backlog. " & FORMAT ( _Wait, "#,0", "en-US" ) & IF ( _Wait = 1, " job is", " jobs are" ) & " still waiting for approval.</text></svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: abc82169-e233-5238-ad9f-78d90868b26a

	/// KPI 1 (hero): backlog in weeks of crew capacity, on a 0-12 week scale. Band = healthy 4-6 weeks.
	/// Expected: "5.8 wks", amber, "● top of the healthy band"
	measure 'HTML PLAN KPI Backlog' =
			VAR _V = [Backlog Weeks]
			VAR _PW = 423.8
			VAR _C = IF ( _V > 6, "#F87171", IF ( _V >= 4 && _V < 5.5, "#4ADE80", "#FBBF24" ) )
			VAR _Word =
			    IF ( _V > 6, "&#9650; over the healthy band",
			        IF ( _V < 4, "&#9679; below the healthy band",
			            IF ( _V < 5.5, "&#10003; inside the healthy band", "&#9679; top of the healthy band" ) ) )
			VAR _FillW = MIN ( 1, MAX ( 0, _V / 12 ) ) * _PW
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 463.8 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Backlog</text>" &
			"<text x='20' y='100' font-family='Segoe UI' font-size='64' font-weight='500' letter-spacing='-1.5' fill='#EDEDEF'>" & FORMAT ( _V, "0.0", "en-US" ) & "<tspan dx='3' font-size='20' letter-spacing='0' fill='#8B8B93'>wks</tspan></text>" &
			"<rect x='20' y='129' width='423.8' height='4' rx='2' fill='#222227'/>" &
			"<rect x='" & FORMAT ( 20 + _PW / 3, "0.0", "en-US" ) & "' y='129' width='" & FORMAT ( _PW / 6, "0.0", "en-US" ) & "' height='4' fill='#4ADE80' fill-opacity='0.19'/>" &
			"<rect x='17' y='126' width='" & FORMAT ( _FillW + 6, "0.0", "en-US" ) & "' height='10' rx='5' fill='" & _C & "' fill-opacity='0.12'/>" &
			"<rect x='20' y='129' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='4' rx='2' fill='" & _C & "'/>" &
			"<rect x='" & FORMAT ( 19 + _PW / 2, "0.0", "en-US" ) & "' y='124' width='2' height='14' fill='#E4E4E7'/>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='" & _C & "'>" & _Word & "</text>" &
			"<text x='443.8' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>healthy 4&#8211;6 wks</text></svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: e5928345-befe-5fd2-b734-4ac5646ae2f7

	/// KPI 2: jobs started on schedule (12 months), target 90%. Footer = the worst site.
	/// Expected: "72.2%", red, "▲ Houston 60%"
	measure 'HTML PLAN KPI Schedule' =
			VAR _V = [Schedule Compliance % (12M)]
			VAR _C = IF ( _V >= 0.9, "#4ADE80", IF ( _V >= 0.8, "#FBBF24", "#F87171" ) )
			VAR _G = IF ( _V >= 0.9, "&#10003;", IF ( _V >= 0.8, "&#9679;", "&#9650;" ) )
			VAR _Worst = TOPN ( 1, ADDCOLUMNS ( VALUES ( DimSite[SITEID] ), "@s", [Schedule Compliance % (12M)] ), [@s], ASC, DimSite[SITEID], ASC )
			VAR _Id = MAXX ( _Worst, DimSite[SITEID] )
			VAR _FillW = MIN ( 1, MAX ( 0, _V ) ) * 225
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 265 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Jobs started on schedule</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( _V * 100, "0.0", "en-US" ) & "%</text>" &
			"<rect x='20' y='102' width='225' height='4' rx='2' fill='#222227'/>" &
			"<rect x='17' y='99' width='" & FORMAT ( _FillW + 6, "0.0", "en-US" ) & "' height='10' rx='5' fill='" & _C & "' fill-opacity='0.12'/>" &
			"<rect x='20' y='102' width='" & FORMAT ( _FillW, "0.0", "en-US" ) & "' height='4' rx='2' fill='" & _C & "'/>" &
			"<rect x='" & FORMAT ( 19 + 0.9 * 225, "0.0", "en-US" ) & "' y='97' width='2' height='14' fill='#E4E4E7'/>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='" & _C & "'>" & _G & " " & UPPER ( LEFT ( _Id, 1 ) ) & LOWER ( MID ( _Id, 2, 50 ) ) & " " & FORMAT ( MAXX ( _Worst, [@s] ), "0%", "en-US" ) & "</text>" &
			"<text x='245' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>target 90%</text></svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: 7432ffeb-52d4-5608-9f80-47a80ef8e2ac

	/// KPI 3: open jobs approved and ready to schedule (status APPR).
	/// Expected: "1,310", "6,844 h of work", "approved"
	measure 'HTML PLAN KPI Ready' =
			VAR _N = CALCULATE ( COUNTROWS ( FactWorkOrder ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "APPR", REMOVEFILTERS ( DimDate ) ) + 0
			VAR _H = CALCULATE ( SUM ( FactWorkOrder[ESTLABHRS] ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "APPR", REMOVEFILTERS ( DimDate ) ) + 0
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 265 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Ready to schedule</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( _N, "#,0", "en-US" ) & "</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#A1A1AA'>" & FORMAT ( _H, "#,0", "en-US" ) & " h of work</text>" &
			"<text x='245' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>approved</text></svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: d1182b2b-1dcd-5e01-b338-56046e450a16

	/// KPI 4: open jobs waiting for approval (status WAPPR).
	/// Expected: "553", "● 3,488 h stuck"
	measure 'HTML PLAN KPI Waiting' =
			VAR _N = CALCULATE ( COUNTROWS ( FactWorkOrder ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "WAPPR", REMOVEFILTERS ( DimDate ) ) + 0
			VAR _H = CALCULATE ( SUM ( FactWorkOrder[ESTLABHRS] ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "WAPPR", REMOVEFILTERS ( DimDate ) ) + 0
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 265 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Waiting for approval</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( _N, "#,0", "en-US" ) & "</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#FBBF24'>&#9679; " & FORMAT ( _H, "#,0", "en-US" ) & " h stuck</text></svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: f2b02a62-ffc3-5fcc-8c22-f43cc11b7336

	/// KPI 5: open jobs older than 90 days, against the whole open backlog.
	/// Expected: "102" (mockup 95), "3.9% of backlog", "of 2,596"
	measure 'HTML PLAN KPI Aged' =
			VAR _A = [Aged Over 90 Days] + 0
			VAR _O = [Open Work Orders] + 0
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 265 184' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='20' y='34' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>Open over 90 days</text>" &
			"<text x='20' y='78' font-family='Segoe UI' font-size='38' font-weight='500' letter-spacing='-0.5' fill='#EDEDEF'>" & FORMAT ( _A, "#,0", "en-US" ) & "</text>" &
			"<text x='20' y='163' font-family='Consolas' font-size='13' fill='#A1A1AA'>" & FORMAT ( DIVIDE ( _A, _O ) * 100, "0.0", "en-US" ) & "% of backlog</text>" &
			"<text x='245' y='163' text-anchor='end' font-family='Consolas' font-size='13' fill='#5C5C66'>of " & FORMAT ( _O, "#,0", "en-US" ) & "</text></svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: 25fa3727-5984-5ca7-b2d0-8130890efcdd

	/// Card: how many weeks of work is waiting - per site, backlog weeks on a 0-12 scale (band 4-6)
	/// and the open hours split by status. Expected: Houston 10.1 over, Aurora 4.4 in band, Bedford 2.8 low
	measure 'HTML PLAN Weeks' =
			VAR _T =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@w", [Backlog Weeks],
			        "@n", [Open Work Orders] + 0,
			        "@cap", [Weekly Craft Capacity (Hours)] + 0,
			        "@h1", CALCULATE ( SUM ( FactWorkOrder[ESTLABHRS] ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "APPR", REMOVEFILTERS ( DimDate ) ) + 0,
			        "@h2", CALCULATE ( SUM ( FactWorkOrder[ESTLABHRS] ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "WAPPR", REMOVEFILTERS ( DimDate ) ) + 0,
			        "@h3", CALCULATE ( SUM ( FactWorkOrder[ESTLABHRS] ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[STATUS] = "INPRG", REMOVEFILTERS ( DimDate ) ) + 0,
			        "@o", SWITCH ( DimSite[SITEID], "HOUSTON", 1, "AURORA", 2, "BEDFORD", 3, 9 ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@nm", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) )
			    )
			VAR _R = ADDCOLUMNS ( _T, "@k", VAR _o = [@o] RETURN COUNTROWS ( FILTER ( _T, [@o] < _o ) ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1046 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>How many weeks of work is waiting &#8212; and is it ready?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>open estimated hours &#247; crew capacity (assumed) &#183; healthy band 4&#8211;6 weeks</text>" &
			CONCATENATEX (
			    _R,
			    VAR _y = 98 + 66 * [@k]
			    VAR _v = [@w]
			    VAR _col = IF ( _v > 6, "#F87171", IF ( _v < 4, "#FBBF24", "#4ADE80" ) )
			    VAR _word = IF ( _v > 6, "over", IF ( _v < 4, "low", "in band" ) )
			    VAR _fw = MIN ( 1, MAX ( 0, _v / 12 ) ) * 672
			    VAR _tot = [@h1] + [@h2] + [@h3]
			    VAR _w1 = DIVIDE ( [@h1], _tot ) * 672
			    VAR _w2 = DIVIDE ( [@h2], _tot ) * 672
			    VAR _w3 = DIVIDE ( [@h3], _tot ) * 672
			    RETURN
			    "<circle cx='26' cy='" & ( _y + 4 ) & "' r='7' fill='" & [@c] & "' fill-opacity='0.25'/>" &
			    "<circle cx='26' cy='" & ( _y + 4 ) & "' r='4' fill='" & [@c] & "'/>" &
			    "<text x='38' y='" & ( _y + 9 ) & "' font-family='Segoe UI' font-size='15' fill='#EDEDEF'>" & [@nm] & "</text>" &
			    "<rect x='192' y='" & _y & "' width='672' height='4' rx='2' fill='#222227'/>" &
			    "<rect x='416' y='" & _y & "' width='112' height='4' fill='#4ADE80' fill-opacity='0.25'/>" &
			    "<rect x='189' y='" & ( _y - 3 ) & "' width='" & FORMAT ( _fw + 6, "0.0", "en-US" ) & "' height='10' rx='5' fill='" & _col & "' fill-opacity='0.12'/>" &
			    "<rect x='192' y='" & _y & "' width='" & FORMAT ( _fw, "0.0", "en-US" ) & "' height='4' rx='2' fill='" & _col & "'/>" &
			    "<rect x='527' y='" & ( _y - 5 ) & "' width='2' height='14' fill='#E4E4E7'/>" &
			    IF ( [@h1] > 0, "<rect x='192' y='" & ( _y + 16 ) & "' width='" & FORMAT ( MAX ( _w1 - 2, 1 ), "0.0", "en-US" ) & "' height='6' rx='2' fill='#D4D4D8'/>" ) &
			    IF ( [@h2] > 0, "<rect x='" & FORMAT ( 192 + _w1, "0.0", "en-US" ) & "' y='" & ( _y + 16 ) & "' width='" & FORMAT ( MAX ( _w2 - 2, 1 ), "0.0", "en-US" ) & "' height='6' rx='2' fill='#FBBF24'/>" ) &
			    IF ( [@h3] > 0, "<rect x='" & FORMAT ( 192 + _w1 + _w2, "0.0", "en-US" ) & "' y='" & ( _y + 16 ) & "' width='" & FORMAT ( MAX ( _w3, 1 ), "0.0", "en-US" ) & "' height='6' rx='2' fill='#60708A'/>" ) &
			    "<text x='1024' y='" & ( _y + 6 ) & "' text-anchor='end'><tspan font-family='Segoe UI' font-size='22' font-weight='500' fill='" & _col & "'>" & FORMAT ( _v, "0.0", "en-US" ) & "</tspan>" &
			        "<tspan font-family='Consolas' font-size='12' fill='#A1A1AA'> wks &#183; " & _word & "</tspan></text>" &
			    "<text x='1024' y='" & ( _y + 23 ) & "' text-anchor='end' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & FORMAT ( [@n], "#,0", "en-US" ) & " WOs &#183; " & FORMAT ( [@cap], "#,0", "en-US" ) & " h/wk</text>",
			    "", [@k], ASC ) &
			"<g font-family='Consolas' font-size='12' fill='#A1A1AA'><text x='192' y='287'>open hours by status:</text>" &
			"<rect x='348' y='278' width='10' height='10' rx='3' fill='#D4D4D8'/><text x='364' y='287'>ready</text>" &
			"<rect x='413' y='278' width='10' height='10' rx='3' fill='#FBBF24'/><text x='429' y='287'>waiting for approval</text>" &
			"<rect x='577' y='278' width='10' height='10' rx='3' fill='#60708A'/><text x='593' y='287'>in progress</text></g></svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: 17a083ee-7f12-51f3-b033-8dd74be1fb73

	/// Card: are we starting work when we planned - share of jobs started within 2 days of their
	/// scheduled start, by scheduled-start month, 3-month rolling average, one smooth glowing line
	/// per site, dashed target at 90%. Whole data window (like the mockup).
	/// Expected last points (Jun 2026): Bedford 84%, Aurora 81%, Houston 62%
	measure 'HTML PLAN Schedule' =
			VAR _AsOf = [Data As Of Date]
			VAR _M0 = EOMONTH ( CALCULATE ( MIN ( FactWorkOrder[ReportDate] ), REMOVEFILTERS () ), 0 ) + 1
			VAR _NM = DATEDIFF ( _M0, EOMONTH ( _AsOf, -1 ), MONTH ) + 1
			VAR _Mo = ADDCOLUMNS ( GENERATESERIES ( 0, _NM - 1, 1 ), "@m", EDATE ( _M0, [Value] ) )
			VAR _V0 =
			    ADDCOLUMNS (
			        CROSSJOIN ( VALUES ( DimSite[SITEID] ), _Mo ),
			        "@v", VAR _m = [@m] RETURN CALCULATE ( [Schedule Compliance %], REMOVEFILTERS ( DimDate ),
			                FactWorkOrder[SchedStartDate] >= _m, FactWorkOrder[SchedStartDate] <= EOMONTH ( _m, 0 ) )
			    )
			VAR _V =
			    ADDCOLUMNS ( _V0, "@r",
			        VAR _s = DimSite[SITEID] VAR _i = [Value]
			        RETURN AVERAGEX ( FILTER ( _V0, DimSite[SITEID] = _s && [Value] >= _i - 2 && [Value] <= _i && NOT ISBLANK ( [@v] ) ), [@v] ) )
			VAR _Lo = MIN ( 0.5, FLOOR ( MINX ( _V, [@r] ), 0.1 ) )
			VAR _Hi = 1.0
			VAR _Step = DIVIDE ( 824, MAX ( _NM - 1, 1 ) )
			VAR _h3 = _Step / 3
			VAR _Sites =
			    ADDCOLUMNS (
			        VALUES ( DimSite[SITEID] ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ),
			        "@n", UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) ),
			        "@last", VAR _s = DimSite[SITEID] RETURN MAXX ( FILTER ( _V, DimSite[SITEID] = _s && [Value] = _NM - 1 ), [@r] )
			    )
			VAR _E0 = ADDCOLUMNS ( _Sites, "@ey", 68 + ( _Hi - [@last] ) / ( _Hi - _Lo ) * 200 )
			VAR _Ends = ADDCOLUMNS ( _E0, "@rk", VAR _y = [@ey] VAR _s = DimSite[SITEID] RETURN COUNTROWS ( FILTER ( _E0, [@ey] < _y || ( [@ey] = _y && DimSite[SITEID] < _s ) ) ) )
			VAR _Lab = ADDCOLUMNS ( _Ends, "@ly", VAR _k = [@rk] RETURN MAXX ( FILTER ( _Ends, [@rk] <= _k ), [@ey] + 18 * ( _k - [@rk] ) ) )
			VAR _Ty = 68 + ( _Hi - 0.9 ) / ( _Hi - _Lo ) * 200
			VAR _Lines =
			    CONCATENATEX (
			        _Sites,
			        VAR _s = DimSite[SITEID]
			        VAR _c = [@c]
			        VAR _P = SELECTCOLUMNS ( FILTER ( _V, DimSite[SITEID] = _s ), "@i", [Value], "@x", 68 + [Value] * _Step, "@y", 68 + ( _Hi - [@r] ) / ( _Hi - _Lo ) * 200 )
			        VAR _D = ADDCOLUMNS ( _P, "@d", VAR _i = [@i] RETURN DIVIDE ( MAXX ( FILTER ( _P, [@i] = _i + 1 ), [@y] ) - [@y], _Step ) )
			        VAR _T =
			            ADDCOLUMNS ( _D, "@m",
			                VAR _i = [@i] VAR _a = MAXX ( FILTER ( _D, [@i] = _i - 1 ), [@d] ) VAR _b = [@d]
			                RETURN IF ( _i = 0, _b, IF ( _i = _NM - 1, _a, IF ( _a * _b <= 0, 0, ( _a + _b ) / 2 * MIN ( 1, 3 * MIN ( ABS ( _a ), ABS ( _b ) ) / MAX ( ABS ( ( _a + _b ) / 2 ), 1e-9 ) ) ) ) ) )
			        VAR _Path =
			            "M68," & FORMAT ( MAXX ( FILTER ( _T, [@i] = 0 ), [@y] ), "0.0", "en-US" ) &
			            CONCATENATEX ( FILTER ( _T, [@i] < _NM - 1 ),
			                VAR _i = [@i]
			                VAR _x2 = MAXX ( FILTER ( _T, [@i] = _i + 1 ), [@x] )
			                VAR _y2 = MAXX ( FILTER ( _T, [@i] = _i + 1 ), [@y] )
			                VAR _m2 = MAXX ( FILTER ( _T, [@i] = _i + 1 ), [@m] )
			                RETURN " C" & FORMAT ( [@x] + _h3, "0.0", "en-US" ) & "," & FORMAT ( [@y] + [@m] * _h3, "0.0", "en-US" ) & " " &
			                    FORMAT ( _x2 - _h3, "0.0", "en-US" ) & "," & FORMAT ( _y2 - _m2 * _h3, "0.0", "en-US" ) & " " & FORMAT ( _x2, "0.0", "en-US" ) & "," & FORMAT ( _y2, "0.0", "en-US" ),
			                "", [@i], ASC )
			        VAR _ex = FORMAT ( 68 + ( _NM - 1 ) * _Step, "0.0", "en-US" )
			        VAR _ey = FORMAT ( MAXX ( FILTER ( _T, [@i] = _NM - 1 ), [@y] ), "0.0", "en-US" )
			        RETURN
			        "<path d='" & _Path & "' fill='none' stroke='" & _c & "' stroke-width='14.4' stroke-opacity='0.06' stroke-linecap='round'/>" &
			        "<path d='" & _Path & "' fill='none' stroke='" & _c & "' stroke-width='7.2' stroke-opacity='0.16' stroke-linecap='round'/>" &
			        "<path d='" & _Path & "' fill='none' stroke='" & _c & "' stroke-width='2.4' stroke-linecap='round'/>" &
			        "<circle cx='" & _ex & "' cy='" & _ey & "' r='4' fill='" & _c & "'/>",
			        "" )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1046 326' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Are we starting work when we planned?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>planned jobs started within 2 days of scheduled start &#183; 3-month rolling average</text>" &
			CONCATENATEX (
			    FILTER ( GENERATESERIES ( 0, 1, 0.1 ), [Value] >= _Lo - 0.001 ),
			    VAR _gy = 68 + ( _Hi - [Value] ) / ( _Hi - _Lo ) * 200
			    RETURN "<line x1='68' x2='892' y1='" & FORMAT ( _gy, "0.0", "en-US" ) & "' y2='" & FORMAT ( _gy, "0.0", "en-US" ) & "' stroke='#1D1D21'/>" &
			        "<text x='58' y='" & FORMAT ( _gy + 4, "0.0", "en-US" ) & "' text-anchor='end' font-family='Consolas' font-size='12' fill='#5C5C66'>" & FORMAT ( [Value] * 100, "0", "en-US" ) & "</text>",
			    "" ) &
			CONCATENATEX (
			    FILTER ( _Mo, MOD ( [Value], 6 ) = 0 || [Value] = _NM - 1 ),
			    "<text x='" & FORMAT ( 68 + [Value] * _Step, "0.0", "en-US" ) & "' y='288' text-anchor='middle' font-family='Consolas' font-size='12' fill='#5C5C66'>" & FORMAT ( [@m], "mmm yy", "en-US" ) & "</text>",
			    "" ) &
			"<line x1='68' x2='892' y1='" & FORMAT ( _Ty, "0.0", "en-US" ) & "' y2='" & FORMAT ( _Ty, "0.0", "en-US" ) & "' stroke='#FBBF24' stroke-width='1.3' stroke-dasharray='5 5'/>" &
			"<text x='74' y='" & FORMAT ( _Ty - 7, "0.0", "en-US" ) & "' font-family='Consolas' font-size='11' fill='#FBBF24'>target 90%</text>" &
			_Lines &
			CONCATENATEX ( _Lab,
			    "<text x='904' y='" & FORMAT ( [@ly] + 4, "0.0", "en-US" ) & "' font-family='Segoe UI' font-size='13' fill='" & [@c] & "'>" & [@n] &
			        " <tspan font-family='Consolas' font-weight='600'>" & FORMAT ( [@last] * 100, "0", "en-US" ) & "%</tspan></text>",
			    "" ) & "</svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: c4a1cb22-7261-56c1-b501-24e36de464bf

	/// Card: which crafts are the bottleneck - booked hours over the last 12 months against capacity
	/// (active people x 40 h x 52 weeks). Tick = 100%. Crafts booking under 5% are named as a data gap.
	/// Expected: Mechanic 137%, Electrician 112%, Operator 71%, HVAC 69%, Lube tech 59%, Instrument 55%, Millwright 41%
	measure 'HTML PLAN Crafts' =
			VAR _AsOf = [Data As Of Date]
			VAR _Sites = VALUES ( DimSite[SITEID] )
			VAR _All =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( DimLabor[CRAFT] ), DimLabor[IsWrenchCraft] = 1, DimLabor[STATUS] = "ACTIVE", REMOVEFILTERS ( DimLabor ) ),
			        "@hc", VAR _cf = DimLabor[CRAFT] RETURN CALCULATE ( COUNTROWS ( DimLabor ), REMOVEFILTERS ( DimLabor ), DimLabor[CRAFT] = _cf, DimLabor[STATUS] = "ACTIVE", TREATAS ( _Sites, DimLabor[SITEID] ) ) + 0,
			        "@h", VAR _cf = DimLabor[CRAFT] RETURN CALCULATE ( SUM ( FactLabour[REGULARHRS] ) + SUM ( FactLabour[PREMIUMPAYHOURS] ), REMOVEFILTERS ( DimDate ), REMOVEFILTERS ( DimLabor ),
			                TREATAS ( { _cf }, FactLabour[CRAFT] ), FactLabour[TransDate] > EDATE ( _AsOf, -12 ), FactLabour[TransDate] <= _AsOf ) + 0
			    )
			VAR _U = ADDCOLUMNS ( FILTER ( _All, [@hc] > 0 ), "@u", DIVIDE ( [@h], [@hc] * 40 * 52 ) )
			VAR _Shown = TOPN ( 7, FILTER ( _U, [@u] >= 0.05 ), [@u], DESC, DimLabor[CRAFT], ASC )
			VAR _Gap = FILTER ( _U, [@u] < 0.05 )
			VAR _R = ADDCOLUMNS ( _Shown, "@k", VAR _uv = [@u] VAR _cf = DimLabor[CRAFT] RETURN COUNTROWS ( FILTER ( _Shown, [@u] > _uv || ( [@u] = _uv && DimLabor[CRAFT] < _cf ) ) ) )
			VAR _AllSites = COUNTROWS ( _Sites ) = COUNTROWS ( ALL ( DimSite[SITEID] ) )
			VAR _GapNames =
			    CONCATENATEX ( _Gap,
			        SWITCH ( DimLabor[CRAFT], "WELD", "welders", "PIPE", "pipefitters", "PDM", "predictive techs", "MECH", "mechanics", "ELECT", "electricians",
			            "OPER", "operators", "HVAC", "HVAC techs", "LUBE", "lube techs", "INSTR", "instrument techs", "MILLWR", "millwrights", LOWER ( DimLabor[CRAFT] ) ),
			        " and ", DimLabor[CRAFT], ASC )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 520 666' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Which crafts are the bottleneck?</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>" &
			    IF ( _AllSites, "all sites", CONCATENATEX ( _Sites, UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) ), ", " ) ) & "</text>" &
			"<g font-family='Consolas' font-size='10.5' letter-spacing='0.4' fill='#5C5C66'><text x='22' y='82'>CRAFT</text><text x='146' y='82'>BOOKED HOURS vs CAPACITY &#183; last 12 mo</text><text x='498' y='82' text-anchor='end'>UTIL.</text></g>" &
			"<line x1='22' x2='498' y1='91.5' y2='91.5' stroke='#232327'/>" &
			CONCATENATEX (
			    _R,
			    VAR _y = 119 + 58 * [@k]
			    VAR _ut = [@u]
			    VAR _col = IF ( _ut > 1, "#F87171", IF ( _ut > 0.85, "#FBBF24", "#A1A1AA" ) )
			    VAR _w = MIN ( _ut, 1.5 ) / 1.5 * 268
			    VAR _name = SWITCH ( DimLabor[CRAFT], "MECH", "Mechanic", "ELECT", "Electrician", "OPER", "Operator", "HVAC", "HVAC", "LUBE", "Lube tech",
			        "INSTR", "Instrument", "MILLWR", "Millwright", "WELD", "Welder", "PIPE", "Pipefitter", "PDM", "Predictive tech", DimLabor[CRAFT] )
			    RETURN
			    "<text x='22' y='" & _y & "' font-family='Segoe UI' font-size='14' fill='#EDEDEF'>" & _name & "</text>" &
			    "<text x='22' y='" & ( _y + 16 ) & "' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & [@hc] & IF ( [@hc] = 1, " person", " people" ) & "</text>" &
			    "<rect x='146' y='" & ( _y - 2 ) & "' width='268' height='8' rx='4' fill='#222227'/>" &
			    IF ( _col <> "#A1A1AA", "<rect x='142' y='" & ( _y - 6 ) & "' width='" & FORMAT ( _w + 8, "0.0", "en-US" ) & "' height='16' rx='8' fill='" & _col & "' fill-opacity='0.14'/>" ) &
			    "<rect x='146' y='" & ( _y - 2 ) & "' width='" & FORMAT ( _w, "0.0", "en-US" ) & "' height='8' rx='4' fill='" & _col & "'/>" &
			    "<rect x='323.7' y='" & ( _y - 6 ) & "' width='2' height='16' fill='#E4E4E7'/>" &
			    "<text x='498' y='" & ( _y + 6 ) & "' text-anchor='end' font-family='Consolas' font-size='13' fill='" & _col & "'>" & FORMAT ( _ut * 100, "0", "en-US" ) & "%</text>" &
			    "<line x1='22' x2='498' y1='" & ( _y + 28.5 ) & "' y2='" & ( _y + 28.5 ) & "' stroke='#1C1C20'/>",
			    "", [@k], ASC ) &
			IF ( NOT ISEMPTY ( _Gap ),
			    "<text x='22' y='625' font-family='Consolas' font-size='11.5' fill='#5C5C66'><tspan fill='#FBBF24'>Data gap:</tspan> " & _GapNames & " book &lt;5% of capacity &#8212;</text>" &
			    "<text x='22' y='642' font-family='Consolas' font-size='11.5' fill='#5C5C66'>the synthetic labour data barely uses them. Tick = 100%.</text>",
			    "<text x='22' y='642' font-family='Consolas' font-size='11.5' fill='#5C5C66'>Tick = 100% of capacity.</text>" ) & "</svg>"
		displayFolder: Report Cards\4 Planning
		lineageTag: ff9b6fc7-4a71-5519-b645-8996acdcb2f1

	/// Page title.
	measure 'HTML INFO Title' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1590 88' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='8' y='42' font-family='Segoe UI' font-size='40' font-weight='300' letter-spacing='-0.5' fill='#EDEDEF'>How to read this report</text>" &
			"<text x='8' y='73' font-family='Segoe UI' font-size='17' fill='#A1A1AA'>Definitions, targets and the data&#8217;s known limits.</text></svg>"
		displayFolder: Report Cards\5 Information
		lineageTag: e5847c3a-00d9-5f7c-b20b-1e75cec081ef

	/// Card: what the status colours mean.
	measure 'HTML INFO Status' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 516 150' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Status</text>" &
			"<text x='22' y='73' font-family='Segoe UI' font-size='15'><tspan fill='#4ADE80'>&#10003;</tspan><tspan fill='#A1A1AA'> on target</tspan></text>" &
			"<circle cx='131' cy='68' r='3' fill='#FBBF24'/><text x='138' y='73' font-family='Segoe UI' font-size='15' fill='#A1A1AA'>near</text>" &
			"<text x='194' y='73' font-family='Segoe UI' font-size='15'><tspan fill='#F87171'>&#9650;</tspan><tspan fill='#A1A1AA'> off target</tspan></text>" &
			"<text x='22' y='102' font-family='Consolas' font-size='12' fill='#A1A1AA'>Status colours only ever mean status.</text></svg>"
		displayFolder: Report Cards\5 Information
		lineageTag: 7d7f7262-fa35-5088-827c-16b7750101e8

	/// Card: what the site colours mean.
	measure 'HTML INFO Sites' =
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 516 150' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Sites</text>" &
			CONCATENATEX (
			    ADDCOLUMNS ( ALL ( DimSite[SITEID] ),
			        "@o", SWITCH ( DimSite[SITEID], "BEDFORD", 0, "AURORA", 1, "HOUSTON", 2, 3 ),
			        "@c", SWITCH ( DimSite[SITEID], "HOUSTON", "#C084FC", "AURORA", "#22D3EE", "BEDFORD", "#60A5FA", "#A1A1AA" ) ),
			    VAR _x = 27 + [@o] * 92
			    RETURN
			    "<circle cx='" & _x & "' cy='68' r='7' fill='" & [@c] & "' fill-opacity='0.25'/><circle cx='" & _x & "' cy='68' r='4' fill='" & [@c] & "'/>" &
			    "<text x='" & ( _x + 12 ) & "' y='73' font-family='Segoe UI' font-size='15' fill='#EDEDEF'>" & UPPER ( LEFT ( DimSite[SITEID], 1 ) ) & LOWER ( MID ( DimSite[SITEID], 2, 50 ) ) & "</text>",
			    "", [@o], ASC ) &
			"<text x='22' y='102' font-family='Consolas' font-size='12' fill='#A1A1AA'>Site colours never signal good or bad.</text></svg>"
		displayFolder: Report Cards\5 Information
		lineageTag: 6d97d3b0-8459-5502-85f9-c98cb0fe3664

	/// Card: the data window. Expected: "Jul 2023 – Jul 2026", "40,935 work orders · 900 assets · 3 sites"
	measure 'HTML INFO Window' =
			VAR _From = CALCULATE ( MIN ( FactWorkOrder[ReportDate] ), REMOVEFILTERS () )
			VAR _WO = CALCULATE ( COUNTROWS ( FactWorkOrder ), FactWorkOrder[IsCancelled] = 0, REMOVEFILTERS () )
			VAR _A = CALCULATE ( COUNTROWS ( DimAsset ), DimAsset[ASSETNUM] <> "(none)", REMOVEFILTERS () )
			VAR _S = COUNTROWS ( ALL ( DimSite[SITEID] ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 516 150' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Data window</text>" &
			"<text x='22' y='77' font-family='Segoe UI' font-size='22' font-weight='500' fill='#EDEDEF'>" & FORMAT ( _From, "mmm yyyy", "en-US" ) & " &#8211; " & FORMAT ( [Data As Of Date], "mmm yyyy", "en-US" ) & "</text>" &
			"<text x='22' y='100' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & FORMAT ( _WO, "#,0", "en-US" ) & " work orders &#183; " & FORMAT ( _A, "#,0", "en-US" ) & " assets &#183; " & _S & " sites</text></svg>"
		displayFolder: Report Cards\5 Information
		lineageTag: 5781946e-da38-5ca4-83e2-75066fd64636

	/// Card: KPI definitions as implemented in the model, with their targets.
	measure 'HTML INFO KPI Definitions' =
			VAR _Rows =
			    DATATABLE (
			        "n", STRING, "d1", STRING, "d2", STRING, "t", STRING, "y", INTEGER,
			        {
			            { "Reactive maintenance %", "(CM + EM) &#247; all non-cancelled work orders", "", "&lt; 20%", 115 },
			            { "PM compliance %", "PMs finished on or before target &#247; completed PMs", "", "&#8805; 90%", 161 },
			            { "Statutory compliance %", "inspection + safety WOs finished on time &#247;", "completed", "100%", 217 },
			            { "MTBF", "operating hours &#247; failure events (operating-hours", "assumption)", "trend only", 282 },
			            { "MTTR", "elapsed downtime &#247; downtime events &#8212; not labour", "hours", "lower is better", 347 },
			            { "Backlog (weeks)", "open estimated labour hours &#247; (active trades &#215; 40 h)", "", "4&#8211;6 weeks", 402 },
			            { "Cost % of RAV", "annual maintenance cost &#247; asset replacement value", "", "2&#8211;3%", 448 },
			            { "Bad actor", "top 5% of assets by failure count", "", "&#8212;", 494 }
			        }
			    )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 728 694' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>KPI definitions</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>as implemented in the semantic model</text>" &
			"<g font-family='Consolas' font-size='10.5' letter-spacing='0.4' fill='#5C5C66'><text x='22' y='82'>KPI</text><text x='236' y='82'>DEFINITION</text><text x='706' y='82' text-anchor='end'>TARGET</text></g>" &
			"<line x1='22' x2='706' y1='91.5' y2='91.5' stroke='#232327'/>" &
			CONCATENATEX (
			    _Rows,
			    VAR _c = [y]
			    VAR _two = [d2] <> ""
			    RETURN
			    "<text x='22' y='" & ( _c + 5 ) & "' font-family='Segoe UI' font-size='14' font-weight='600' fill='#EDEDEF'>" & [n] & "</text>" &
			    "<text x='236' y='" & IF ( _two, _c - 4, _c + 5 ) & "' font-family='Segoe UI' font-size='14' fill='#A1A1AA'>" & [d1] & "</text>" &
			    IF ( _two, "<text x='236' y='" & ( _c + 15 ) & "' font-family='Segoe UI' font-size='14' fill='#A1A1AA'>" & [d2] & "</text>" ) &
			    "<text x='706' y='" & ( _c + 5 ) & "' text-anchor='end' font-family='Consolas' font-size='13' fill='#EDEDEF'>" & [t] & "</text>" &
			    "<line x1='22' x2='706' y1='" & ( _c + IF ( _two, 32.5, 23.5 ) ) & "' y2='" & ( _c + IF ( _two, 32.5, 23.5 ) ) & "' stroke='#1C1C20'/>",
			    "", [y], ASC ) &
			"<text x='22' y='670' font-family='Consolas' font-size='11.5' fill='#5C5C66'>Targets follow SMRP best-practice benchmarks. Every KPI has a DAX test case in <tspan fill='#B4B4BC'>verify_measures.py</tspan>.</text></svg>"
		displayFolder: Report Cards\5 Information
		lineageTag: 6ad72a7e-6f2a-5cdc-b2d1-597885e27f7f

	/// Card: work types, straight from DimWorkType, so it cannot drift from the data.
	measure 'HTML INFO Work Types' =
			VAR _T = ADDCOLUMNS ( ALL ( DimWorkType[WORKTYPE], DimWorkType[WorkTypeName], DimWorkType[WorkTypeGroup], DimWorkType[SortOrder] ), "@k", VAR _so = DimWorkType[SortOrder] RETURN COUNTROWS ( FILTER ( ALL ( DimWorkType[SortOrder] ), DimWorkType[SortOrder] < _so ) ) )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 420 694' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Work types</text>" &
			"<text x='22' y='56' font-family='Consolas' font-size='12' fill='#5C5C66'>reactive = unplanned; drives Reactive %</text>" &
			CONCATENATEX (
			    _T,
			    VAR _c = 84 + 36 * [@k]
			    VAR _re = DimWorkType[WorkTypeGroup] = "Reactive"
			    RETURN
			    "<rect x='22.5' y='" & ( _c - 8.5 ) & "' width='" & FORMAT ( 12 + LEN ( DimWorkType[WORKTYPE] ) * 5.8, "0.0", "en-US" ) & "' height='17' rx='5' fill='none' stroke='#33333A'/>" &
			    "<text x='28' y='" & ( _c + 4 ) & "' font-family='Consolas' font-size='10.5' fill='#B4B4BC'>" & DimWorkType[WORKTYPE] & "</text>" &
			    "<text x='96' y='" & ( _c + 5 ) & "' font-family='Segoe UI' font-size='14' fill='#EDEDEF'>" & DimWorkType[WorkTypeName] & "</text>" &
			    "<text x='398' y='" & ( _c + 4 ) & "' text-anchor='end' font-family='Consolas' font-size='13' fill='" & IF ( _re, "#F87171", "#A1A1AA" ) & "'>" & LOWER ( DimWorkType[WorkTypeGroup] ) & "</text>" &
			    IF ( [@k] < COUNTROWS ( _T ) - 1, "<line x1='22' x2='398' y1='" & ( _c + 18.5 ) & "' y2='" & ( _c + 18.5 ) & "' stroke='#1C1C20'/>" ),
			    "", [@k], ASC ) &
			"<text x='22' y='652' font-family='Consolas' font-size='11.5' fill='#5C5C66'>Definitions live in DimWorkType, so this list can&#8217;t drift</text>" &
			"<text x='22' y='670' font-family='Consolas' font-size='11.5' fill='#5C5C66'>from the data.</text></svg>"
		displayFolder: Report Cards\5 Information
		lineageTag: 1f8c84b1-a68d-5d83-a65b-58fdb68a8a9f

	/// Card: read before you quote a number - the data's known limits.
	/// Expected "Open work": 732 open WOs with report dates after the cut-off (mockup 827)
	measure 'HTML INFO Notes' =
			VAR _AsOf = [Data As Of Date]
			VAR _Future = CALCULATE ( COUNTROWS ( FactWorkOrder ), FactWorkOrder[IsOpen] = 1, FactWorkOrder[ReportDate] > _AsOf, REMOVEFILTERS () ) + 0
			VAR _Notes =
			    DATATABLE (
			        "h", STRING, "l1", STRING, "l2", STRING, "i", INTEGER,
			        {
			            { "Synthetic data", "Generated @asof, seed 20260729. No real site,", "asset or person.", 0 },
			            { "Recent months", "Recent work is left open on purpose, so the last ~3", "months understate completions, failures and cost.", 1 },
			            { "Provisional", "MTBF year-on-year is flagged until the end-of-window", "effect is ruled out.", 2 },
			            { "Open work", "@future open WOs carry report dates after the cut-off and", "are counted in backlog.", 3 },
			            { "Capacity", "Not in Maximo. Assumed: active trades &#215; 40 h/week.", "", 4 }
			        }
			    )
			RETURN
			"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 694' width='100%' style='display:block;max-height:100vh'>" &
			"<text x='22' y='37' font-family='Segoe UI' font-size='17' font-weight='600' fill='#EDEDEF'>Read before you quote a number</text>" &
			CONCATENATEX (
			    _Notes,
			    VAR _y = 70 + 72 * [i]
			    VAR _l1 = SUBSTITUTE ( SUBSTITUTE ( [l1], "@asof", FORMAT ( _AsOf, "d mmm yyyy", "en-US" ) ), "@future", FORMAT ( _Future, "#,0", "en-US" ) )
			    RETURN
			    "<text x='22' y='" & _y & "' font-family='Segoe UI' font-size='14' font-weight='600' fill='#EDEDEF'>" & [h] & "</text>" &
			    "<text x='22' y='" & ( _y + 20 ) & "' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & _l1 & "</text>" &
			    IF ( [l2] <> "", "<text x='22' y='" & ( _y + 38 ) & "' font-family='Consolas' font-size='12' fill='#A1A1AA'>" & [l2] & "</text>" ),
			    "", [i], ASC ) & "</svg>"
		displayFolder: Report Cards\5 Information
		lineageTag: d8a88a95-dbec-57dc-a3ce-8356bdde320d

	column Column1
		dataType: string
		isHidden
		lineageTag: ca472215-43ec-4415-8f22-d5ab6340577a
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				  Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

