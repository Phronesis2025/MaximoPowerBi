table DimSite
	lineageTag: b566670e-bcb2-4b0d-a973-d7bdc4d57f6c

	column SITEID
		dataType: string
		lineageTag: 8169ce41-b995-4235-8e73-59d49c2db4b2
		summarizeBy: none
		sourceColumn: SITEID

		annotation SummarizationSetBy = Automatic

